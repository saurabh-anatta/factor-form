{% doc %}
  Product Info Card Block

  Branded green info card with badges, title, rating, price, tags, and description.

  @example {% content_for 'block', type: 'pdp-hero-card', id: 'hero-card' %}
{% enddoc %}

{% liquid
  assign product = closest.product
  assign bg_color = block.settings.bg_color | default: '#2A523F'
  assign badge_1_text = block.settings.badge_1_text
  assign badge_1_bg = block.settings.badge_1_bg_color | default: '#FFFFFF'
  assign badge_1_color = block.settings.badge_1_text_color | default: '#141414'
  assign badge_2_text = block.settings.badge_2_text
  assign badge_2_bg = block.settings.badge_2_bg_color | default: '#EC0606'
  assign badge_2_color = block.settings.badge_2_text_color | default: '#FFFFFF'
  assign tags_text = block.settings.tags
  assign supplement_text = block.settings.supplement_facts_text
  assign supplement_url = block.settings.supplement_facts_url
%}

<div
  class="pdp-hero-card"
  style="--hero-card-bg: {{ bg_color }};"
  {{ block.shopify_attributes }}
>
  {%- comment -%} Badges row {%- endcomment -%}
  <div class="pdp-hero-card__badges">
    {%- if badge_1_text != blank -%}
      <span
        class="pdp-hero-card__badge"
        style="background-color: {{ badge_1_bg }}; color: {{ badge_1_color }};"
      >
        {{- badge_1_text | escape -}}
      </span>
    {%- endif -%}
    {%- if badge_2_text != blank -%}
      <span
        class="pdp-hero-card__badge"
        style="background-color: {{ badge_2_bg }}; color: {{ badge_2_color }};"
      >
        {{- badge_2_text | escape -}}
      </span>
    {%- endif -%}
  </div>

  {%- comment -%} Product title {%- endcomment -%}
  <div class="pdp-hero-card__title-wrap">
    <h1 class="pdp-hero-card__title">{{ product.title | escape }}</h1>
  </div>

  {%- comment -%} Rating + Price row {%- endcomment -%}
  <div class="pdp-hero-card__meta">
    {%- if block.settings.show_rating -%}
      <div class="pdp-hero-card__ratings">
        <span class="pdp-hero-card__stars pdp-hero-card__stars--desktop">
          <img src="{{ 'stars-2.svg' | asset_url }}" alt="{{ product.metafields.reviews.rating.value | default: '4.9' }} stars" width="96" height="16" loading="lazy">
        </span>
        <span class="pdp-hero-card__stars pdp-hero-card__stars--mobile">
          <img src="{{ 'stars.svg' | asset_url }}" alt="{{ product.metafields.reviews.rating.value | default: '4.9' }} stars" width="66" height="10" loading="lazy">
        </span>
        <span class="pdp-hero-card__rating-text">
          <span class="pdp-hero-card__rating-value">{{ product.metafields.reviews.rating.value | default: '4.9' }}</span>
          <span class="pdp-hero-card__rating-count">({{ product.metafields.reviews.rating_count | default: 51 }} {{ 'content.reviews' | t }})</span>
        </span>
      </div>
    {%- endif -%}
    <div class="pdp-hero-card__price">
      {% liquid
        assign current_variant = product.selected_or_first_available_variant
        assign sale_price = current_variant.price
        assign compare_price = current_variant.compare_at_price
      %}
      <span class="pdp-hero-card__sale-price" data-sale-price>{{ sale_price | money }}</span>
      {%- if compare_price > sale_price -%}
        <span class="pdp-hero-card__compare-price" data-compare-price>
          <s>{{ compare_price | money }}</s>
        </span>
      {%- else -%}
        <span class="pdp-hero-card__compare-price" data-compare-price style="display:none;">
          <s></s>
        </span>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Tags row {%- endcomment -%}
  {%- if tags_text != blank -%}
    <div class="pdp-hero-card__tags">
      {%- assign tag_items = tags_text | split: ',' -%}
      {%- for tag in tag_items -%}
        {%- assign tag_trimmed = tag | strip -%}
        {%- if tag_trimmed != blank -%}
          <span class="pdp-hero-card__tag">{{ tag_trimmed | escape }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} Description {%- endcomment -%}
  {%- if block.settings.description != blank -%}
    <div class="pdp-hero-card__description">
      {{ block.settings.description }}
    </div>
  {%- endif -%}

  {%- comment -%} Supplement facts link {%- endcomment -%}
  {%- if supplement_text != blank -%}
    <div class="pdp-hero-card__supplement">
      {%- if supplement_url != blank -%}
        <a href="{{ supplement_url }}" class="pdp-hero-card__supplement-link">{{ supplement_text | escape }}</a>
      {%- else -%}
        <span class="pdp-hero-card__supplement-link">{{ supplement_text | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} Decorative corner elements {%- endcomment -%}
  <div class="pdp-hero-card__deco pdp-hero-card__deco--left" aria-hidden="true">
    <svg width="14" height="28" viewBox="0 0 14 28" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="14" height="28" rx="2" fill="#FFFFFF"/>
    </svg>
  </div>
  <div class="pdp-hero-card__deco pdp-hero-card__deco--right" aria-hidden="true">
    <svg width="14" height="28" viewBox="0 0 14 28" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="14" height="28" rx="2" fill="#FFFFFF" transform="rotate(3 7 14)"/>
    </svg>
  </div>
</div>

{% stylesheet %}
.pdp-hero-card {
  position: relative;
  background-color: var(--hero-card-bg, #2A523F);
  padding: 32px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  overflow: hidden;

  @media screen and (max-width: 749px) {
    padding: 24px;
    gap: 8px;
  }
}

.pdp-hero-card__badges {
  display: flex;
  flex-direction: row;
  gap: 8px;
  padding-bottom: 8px;
}

.pdp-hero-card__badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  font-family: var(--font-accent--family), sans-serif;
  font-weight: 500;
  font-size: 12px;
  line-height: 16px;
  white-space: nowrap;
}

.pdp-hero-card__title-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.pdp-hero-card__title {
  font-family: var(--font-heading--family), sans-serif;
  font-weight: 300;
  font-size: 40px;
  line-height: 48px;
  color: #FFFFFF;
  margin: 0;

  @media screen and (max-width: 749px) {
    font-size: 32px;
    line-height: 40px;
  }
}

.pdp-hero-card__meta {
  display: flex;
  flex-direction: row;
  gap: 16px;
  justify-content: space-between;
  align-items: center;
}

.pdp-hero-card__ratings {
  display: flex;
  flex-direction: row;
  gap: 8px;
  align-items: center;
}

.pdp-hero-card__stars--desktop {
  display: flex;
  align-items: center;

  @media screen and (max-width: 749px) {
    display: none;
  }
}

.pdp-hero-card__stars--mobile {
  display: none;
  align-items: center;

  @media screen and (max-width: 749px) {
    display: flex;
  }
}

.pdp-hero-card__stars img {
  display: block;
}

.pdp-hero-card__rating-text {
  display: flex;
  gap: 4px;
  align-items: flex-end;
  font-family: var(--font-body--family), sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  color: #FFFFFF;

  @media screen and (max-width: 749px) {
    font-size: 12px;
    line-height: 16px;
  }
}

.pdp-hero-card__price {
  display: flex;
  flex-direction: row;
  gap: 8px;
  align-items: center;
}

.pdp-hero-card__sale-price {
  font-family: var(--font-accent--family), sans-serif;
  font-weight: 500;
  font-size: 24px;
  line-height: 32px;
  color: #FFFFFF;

  @media screen and (max-width: 749px) {
    font-size: 18px;
    line-height: 28px;
  }
}

.pdp-hero-card__compare-price {
  font-family: var(--font-heading--family), sans-serif;
  font-weight: 300;
  font-size: 20px;
  line-height: 28px;
  color: #FFFFFF;
  opacity: 0.7;

  @media screen and (max-width: 749px) {
    font-size: 16px;
    line-height: 24px;
  }
}

.pdp-hero-card__compare-price s {
  text-decoration: line-through;
}

.pdp-hero-card__tags {
  display: flex;
  flex-direction: row;
  gap: 8px;
  flex-wrap: wrap;
}

.pdp-hero-card__tag {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 2px 6px;
  background-color: #F5FAF6;
  color: #2A523F;
  font-family: var(--font-accent--family), sans-serif;
  font-weight: 500;
  font-size: 14px;
  line-height: 20px;
  text-align: center;
  white-space: nowrap;

  @media screen and (max-width: 749px) {
    font-size: 12px;
    line-height: 16px;
  }
}

.pdp-hero-card__description {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  color: #FFFFFF;

  @media screen and (max-width: 749px) {
    font-size: 14px;
    line-height: 20px;
  }
}

.pdp-hero-card__description p {
  margin: 0;
}

.pdp-hero-card__description ul {
  margin: 0;
  padding-inline-start: 0;
  list-style: none;
}

.pdp-hero-card__description li::before {
  content: "• ";
}

.pdp-hero-card__supplement {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;

  @media screen and (max-width: 749px) {
    font-size: 14px;
    line-height: 20px;
  }
}

.pdp-hero-card__supplement-link {
  color: #FFFFFF;
  text-decoration: underline;
  cursor: pointer;
}

.pdp-hero-card__deco {
  position: absolute;
  bottom: 32px;
  pointer-events: none;

  @media screen and (max-width: 749px) {
    bottom: 24px;
  }
}

.pdp-hero-card__deco--left {
  left: 0;
  transform: translateX(-50%);
}

.pdp-hero-card__deco--right {
  left: 14px;
  transform: translateX(-50%) rotate(3deg);
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.pdp_hero_card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "t:settings.bg_color",
      "default": "#2A523F"
    },
    {
      "type": "header",
      "content": "t:settings.badge_1_header"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "t:settings.badge_1_text",
      "default": "NEW"
    },
    {
      "type": "color",
      "id": "badge_1_bg_color",
      "label": "t:settings.badge_1_bg_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "badge_1_text_color",
      "label": "t:settings.badge_1_text_color",
      "default": "#141414"
    },
    {
      "type": "header",
      "content": "t:settings.badge_2_header"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "t:settings.badge_2_text",
      "default": "40% OFF FIRST ORDER"
    },
    {
      "type": "color",
      "id": "badge_2_bg_color",
      "label": "t:settings.badge_2_bg_color",
      "default": "#EC0606"
    },
    {
      "type": "color",
      "id": "badge_2_text_color",
      "label": "t:settings.badge_2_text_color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:settings.show_rating",
      "default": true
    },
    {
      "type": "textarea",
      "id": "tags",
      "label": "t:settings.tags",
      "default": "Fresh & Citrusy, Flavorful Nutrition, Energy + Immunity"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.description"
    },
    {
      "type": "text",
      "id": "supplement_facts_text",
      "label": "t:settings.supplement_facts_text",
      "default": "Supplement Facts"
    },
    {
      "type": "url",
      "id": "supplement_facts_url",
      "label": "t:settings.supplement_facts_url"
    }
  ],
  "presets": [
    {
      "name": "t:names.pdp_hero_card"
    }
  ]
}
{% endschema %}
