    },
    {
      "type": "text",
      "id": "heading_4",
      "label": "t:settings.heading_4"
    },
    {
      "type": "richtext",
      "id": "content_4",
      "label": "t:settings.content_4"
    },
    {
      "type": "text",
      "id": "heading_5",
