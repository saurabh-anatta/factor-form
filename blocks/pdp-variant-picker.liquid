{% doc %}
  Custom Variant Picker Block

  Renders product options as selectable bordered card elements.

  @example {% content_for 'block', type: 'pdp-variant-picker', id: 'variant-picker' %}
{% enddoc %}

{% liquid
  assign product = closest.product
  assign current_variant = product.selected_or_first_available_variant
  assign show_images = block.settings.show_option_images
%}

<div class="pdp-variant-picker" {{ block.shopify_attributes }}>
  {%- for option in product.options_with_values -%}
    {%- assign option_index = forloop.index0 -%}
    <div class="pdp-variant-picker__group" data-option-group data-option-index="{{ option_index }}">
      <div class="pdp-variant-picker__label">
        <span class="pdp-variant-picker__label-text">{{ 'sections.custom_pdp.select_prefix' | t: option: option.name }}:</span>
        <span class="pdp-variant-picker__label-value">{{ current_variant.options[option_index] | escape }}</span>
      </div>
      <div class="pdp-variant-picker__options">
        {%- for value in option.values -%}
          {%- liquid
            assign is_selected = false
            if current_variant.options[option_index] == value
              assign is_selected = true
            endif

            assign variant_for_option = nil
            for variant in product.variants
              if variant.options[option_index] == value
                assign variant_for_option = variant
                break
              endif
            endfor
          -%}
          <button
            type="button"
            class="pdp-variant-picker__card{% if is_selected %} pdp-variant-picker__card--selected{% endif %}"
            data-variant-id="{% if variant_for_option %}{{ variant_for_option.id }}{% else %}{{ current_variant.id }}{% endif %}"
            data-option-value="{{ value | escape }}"
            aria-label="{{ option.name }}: {{ value | escape }}"
            aria-pressed="{{ is_selected }}"
          >
            {%- if show_images and variant_for_option -%}
              {%- liquid
                assign card_image = variant_for_option.featured_image
                unless card_image
                  assign card_image = variant_for_option.image
                endunless
              -%}
              {%- if card_image -%}
                <img
                  class="pdp-variant-picker__card-image"
                  src="{{ card_image | image_url: width: 160 }}"
                  alt="{{ value | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              {%- endif -%}
            {%- endif -%}
            <div class="pdp-variant-picker__card-info">
              <span class="pdp-variant-picker__card-value">{{ value | escape }}</span>
              {%- if variant_for_option -%}
                {%- assign per_day = variant_for_option.price | divided_by: 30 -%}
                <span class="pdp-variant-picker__card-meta">{{ per_day | money }}/day</span>
              {%- endif -%}
            </div>
          </button>
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}

  <script type="application/json" data-variants-json>
    {{ product.variants | json }}
  </script>
</div>

{% stylesheet %}
.pdp-variant-picker {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.pdp-variant-picker__group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.pdp-variant-picker__label {
  display: flex;
  gap: 4px;
  align-items: center;
}

.pdp-variant-picker__label-text {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  color: #141414;
}

.pdp-variant-picker__label-value {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  color: #141414;
}

.pdp-variant-picker__options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;

  @media screen and (max-width: 749px) {
    grid-template-columns: 1fr;
  }
}

.pdp-variant-picker__card {
  display: flex;
  flex-direction: row;
  gap: 12px;
  align-items: center;
  padding: 0;
  border: 1px solid #D0D0BC;
  background: transparent;
  cursor: pointer;
  min-height: 80px;
  text-align: start;
  transition: border-color 0.15s ease;

  @media screen and (max-width: 749px) {
    min-height: 48px;
  }

  &:hover {
    border-color: #141414;
  }
}

.pdp-variant-picker__card--selected {
  border-color: #141414;
}

.pdp-variant-picker__card-image {
  width: 80px;
  height: 80px;
  object-fit: cover;
  flex-shrink: 0;

  @media screen and (max-width: 749px) {
    width: 48px;
    height: 48px;
  }
}

.pdp-variant-picker__card-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 8px;
}

.pdp-variant-picker__card-value {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  color: #141414;
}

.pdp-variant-picker__card-meta {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  color: #4A4A41;
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.pdp_variant_picker",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_option_images",
      "label": "t:settings.show_option_images",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:names.pdp_variant_picker"
    }
  ]
}
{% endschema %}
