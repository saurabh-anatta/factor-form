{% doc %}
  Subscription Quick-Add Drawer

  A right sidebar (desktop) / bottom sheet (mobile) drawer that opens when
  clicking Add to Cart on product cards outside the PDP buybox. Shows variant
  picker, subscription options, and add-to-cart button.

  Include once in layout/theme.liquid.
{% enddoc %}

<subscription-drawer class="sub-drawer" aria-hidden="true">
  <div class="sub-drawer__overlay" data-drawer-close></div>
  <div class="sub-drawer__panel">
    <div class="sub-drawer__header">
      <h2 class="sub-drawer__title" data-drawer-title></h2>
      <button type="button" class="sub-drawer__close" data-drawer-close aria-label="Close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 6L6 18M6 6L18 18" stroke="#141414" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <div class="sub-drawer__body" data-drawer-body>
      <div class="sub-drawer__loading">Loading...</div>
    </div>

    <div class="sub-drawer__footer">
      <button type="button" class="sub-drawer__add-btn" data-drawer-add disabled>
        ADD TO CART
      </button>
      <a href="#" class="sub-drawer__view-link" data-drawer-view-link>View Full Product Details</a>
    </div>
  </div>
</subscription-drawer>

<script src="{{ 'subscription-drawer.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
.sub-drawer {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: none;
  pointer-events: none;
}

.sub-drawer[aria-hidden="false"] {
  display: block;
  pointer-events: auto;
}

.sub-drawer__overlay {
  position: absolute;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.sub-drawer[aria-hidden="false"] .sub-drawer__overlay {
  opacity: 1;
}

.sub-drawer__panel {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 420px;
  max-width: 100%;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.3s ease;
  overflow: hidden;
}

.sub-drawer[aria-hidden="false"] .sub-drawer__panel {
  transform: translateX(0);
}

.sub-drawer__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 24px;
  border-block-end: 1px solid #E7E6E2;
  flex-shrink: 0;
}

.sub-drawer__title {
  font-family: var(--font-heading--family), sans-serif;
  font-weight: 300;
  font-size: 24px;
  line-height: 32px;
  color: #141414;
  margin: 0;
}

.sub-drawer__close {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
  flex-shrink: 0;
}

.sub-drawer__body {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.sub-drawer__loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 0;
  font-family: var(--font-body--family), sans-serif;
  font-size: 14px;
  color: #80806F;
}

.sub-drawer__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.sub-drawer__tag {
  display: inline-flex;
  padding: 2px 6px;
  font-family: var(--font-accent--family), sans-serif;
  font-weight: 500;
  font-size: 14px;
  line-height: 20px;
  color: #141414;
  font-style: italic;
}

.sub-drawer__desc {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  color: #141414;
  margin: 0;
}

.sub-drawer__variant-label {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  color: #141414;
}

.sub-drawer__variant-label strong {
  font-weight: 600;
}

.sub-drawer__variants {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.sub-drawer__variant-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0;
  border: 1px solid #D0D0BC;
  background: transparent;
  cursor: pointer;
  min-height: 64px;
  text-align: start;
  transition: border-color 0.15s ease;
}

.sub-drawer__variant-card:hover {
  border-color: #141414;
}

.sub-drawer__variant-card--selected {
  border-color: #141414;
}

.sub-drawer__variant-img {
  width: 64px;
  height: 64px;
  object-fit: cover;
  flex-shrink: 0;
}

.sub-drawer__variant-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 8px 8px 8px 0;
}

.sub-drawer__variant-name {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  color: #141414;
}

.sub-drawer__variant-meta {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  color: #4A4A41;
}

.sub-drawer__sub-options {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.sub-drawer__sub-option {
  width: 100%;
  border: 1px solid #D0D0BC;
  cursor: pointer;
  transition: border-color 0.15s ease;
}

.sub-drawer__sub-option--selected {
  border-color: #141414;
}

.sub-drawer__sub-badge {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 4px 12px;
  background-color: #E1F0E2;
}

.sub-drawer__sub-badge-text {
  font-family: var(--font-accent--family), sans-serif;
  font-weight: 500;
  font-size: 12px;
  line-height: 16px;
  color: #141414;
}

.sub-drawer__sub-content {
  display: flex;
  justify-content: space-between;
  padding: 12px;
  gap: 8px;
}

.sub-drawer__sub-left {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.sub-drawer__sub-radio-row {
  display: flex;
  gap: 8px;
  align-items: center;
}

.sub-drawer__sub-radio {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid #D0D0BC;
  flex-shrink: 0;
  position: relative;
}

.sub-drawer__sub-option--selected .sub-drawer__sub-radio {
  border-color: #141414;
}

.sub-drawer__sub-option--selected .sub-drawer__sub-radio::after {
  content: '';
  position: absolute;
  top: 3px;
  left: 3px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #141414;
}

.sub-drawer__sub-heading {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  color: #141414;
}

.sub-drawer__sub-details {
  padding-inline-start: 26px;
}

.sub-drawer__sub-benefits {
  margin: 0 0 8px;
  padding-inline-start: 18px;
  font-family: var(--font-body--family), sans-serif;
  font-weight: 400;
  font-size: 13px;
  line-height: 18px;
  color: #141414;
}

.sub-drawer__sub-benefits li {
  margin-bottom: 2px;
}

.sub-drawer__sub-freq-label {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 600;
  font-size: 13px;
  line-height: 18px;
  color: #141414;
  margin-bottom: 8px;
}

.sub-drawer__sub-freqs {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.sub-drawer__sub-freq {
  padding: 6px 16px;
  border: 1px solid #D0D0BC;
  background: transparent;
  font-family: var(--font-body--family), sans-serif;
  font-weight: 400;
  font-size: 13px;
  line-height: 18px;
  color: #141414;
  cursor: pointer;
  transition: border-color 0.15s ease;
}

.sub-drawer__sub-freq:hover {
  border-color: #141414;
}

.sub-drawer__sub-freq--selected {
  border-color: #141414;
  font-weight: 600;
}

.sub-drawer__sub-right {
  display: flex;
  flex-direction: column;
  gap: 4px;
  align-items: flex-end;
  flex-shrink: 0;
}

.sub-drawer__sub-price {
  font-family: var(--font-accent--family), sans-serif;
  font-weight: 500;
  font-size: 16px;
  line-height: 24px;
  color: #141414;
}

.sub-drawer__sub-compare {
  font-family: var(--font-heading--family), sans-serif;
  font-weight: 300;
  font-size: 14px;
  line-height: 20px;
  color: #80806F;
  text-decoration: line-through;
}

.sub-drawer__sub-savings {
  display: inline-flex;
  padding: 2px 8px;
  background-color: #EC0606;
  color: #FFFFFF;
  font-family: var(--font-accent--family), sans-serif;
  font-weight: 700;
  font-size: 12px;
  line-height: 16px;
  white-space: nowrap;
}

.sub-drawer__footer {
  padding: 16px 24px 24px;
  border-block-start: 1px solid #E7E6E2;
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: center;
  flex-shrink: 0;
}

.sub-drawer__add-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 4px 32px;
  min-height: 48px;
  background-color: #141414;
  color: #FFFFFF;
  border: 1px solid #FFFFFF;
  border-radius: 24px;
  font-family: var(--font-accent--family), sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 16px;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  cursor: pointer;
  transition: opacity 0.15s ease;
}

.sub-drawer__add-btn:hover {
  opacity: 0.85;
}

.sub-drawer__add-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.sub-drawer__view-link {
  font-family: var(--font-body--family), sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  color: #141414;
  text-decoration: underline;
}

@media screen and (max-width: 749px) {
  .sub-drawer__panel {
    top: auto;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    max-height: 90vh;
    border-radius: 16px 16px 0 0;
    transform: translateY(100%);
  }

  .sub-drawer[aria-hidden="false"] .sub-drawer__panel {
    transform: translateY(0);
  }

  .sub-drawer__header {
    padding: 16px;
  }

  .sub-drawer__body {
    padding: 16px;
    gap: 16px;
  }

  .sub-drawer__footer {
    padding: 12px 16px 20px;
  }

  .sub-drawer__add-btn {
    min-height: 40px;
    font-size: 14px;
    letter-spacing: 1.2px;
  }
}
{% endstylesheet %}
