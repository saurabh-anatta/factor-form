{% comment %}
  Custom Font Loading — Simplon Norm (FactorForm brand font)

  IMPORTANT: For Simplon Norm to display, the following commercial font files
  must be purchased from Swiss Typefaces, licensed, and uploaded to the theme's
  assets/ directory:

    - simplon-norm-light.woff2    (weight 300)
    - simplon-norm-medium.woff2   (weight 500)
    - simplon-norm-bold.woff2     (weight 700)

  Until those files are present, the theme will gracefully fall back to
  Work Sans (set via Shopify font_picker in settings_data.json).

  Additional custom fonts:
    - IvyOraDisplay-Regular.woff2 (heading override, gated by enable_custom_heading_font)
    - PlusJakartaSans.woff        (body/subheading override, gated by enable_custom_body_font)
{% endcomment %}

<style>
  /* Simplon Norm — brand font (always loaded) */
  @font-face {
    font-family: 'Simplon Norm';
    src: url('{{ "simplon-norm-light.woff2" | asset_url }}') format('woff2');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Simplon Norm';
    src: url('{{ "simplon-norm-medium.woff2" | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Simplon Norm';
    src: url('{{ "simplon-norm-bold.woff2" | asset_url }}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  /* IvyOraDisplay — custom heading font */
  @font-face {
    font-family: 'IvyOraDisplay';
    src: url('{{ "IvyOraDisplay-Regular.woff2" | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* PlusJakartaSans — custom body font */
  @font-face {
    font-family: 'PlusJakartaSans';
    src: url('{{ "PlusJakartaSans.woff" | asset_url }}') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* Simplon Norm :root overrides (always active) */
  :root {
    --font-heading--family: 'Simplon Norm', var(--font-heading--family-fallback, sans-serif);
    --font-heading--weight: 300;
    --font-accent--family: 'Simplon Norm', var(--font-accent--family-fallback, sans-serif);
    --font-accent--weight: 700;
  }
</style>

{% if settings.enable_custom_heading_font %}
  <style>
    :root {
      --font-heading--family: 'IvyOraDisplay', 'Simplon Norm', var(--font-heading--family-fallback, sans-serif);
    }
  </style>
{% endif %}

{% if settings.enable_custom_body_font %}
  <style>
    :root {
      --font-body--family: 'PlusJakartaSans', 'Plus Jakarta Sans', var(--font-body--family-fallback, sans-serif);
      --font-subheading--family: 'PlusJakartaSans', 'Plus Jakarta Sans', var(--font-subheading--family-fallback, sans-serif);
    }
  </style>
{% endif %}
