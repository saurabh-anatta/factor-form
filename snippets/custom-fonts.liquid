{% comment %}
  Custom Font Loading — IvyOraDisplay (FactorForm brand font)

  IMPORTANT: For IvyOraDisplay to display, the following font file
  must be uploaded to the theme's assets/ directory:

    - IvyOraDisplay-Regular.woff2  (weight 400, used for all weight slots)

  Until that file is present, the theme will gracefully fall back to
  Work Sans (set via Shopify font_picker in settings_data.json).

  All @font-face declarations and CSS variable overrides are gated
  behind the enable_custom_heading_font checkbox in Theme Settings >
  Typography so merchants can disable custom fonts at any time.
{% endcomment %}

{% if settings.enable_custom_heading_font %}
  <style>
    @font-face {
      font-family: 'IvyOraDisplay';
      src: url('{{ "IvyOraDisplay-Regular.woff2" | asset_url }}') format('woff2');
      font-weight: 300;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: 'IvyOraDisplay';
      src: url('{{ "IvyOraDisplay-Regular.woff2" | asset_url }}') format('woff2');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: 'IvyOraDisplay';
      src: url('{{ "IvyOraDisplay-Regular.woff2" | asset_url }}') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --font-ivyoradisplay: 'IvyOraDisplay', sans-serif;
    }

    {% case settings.custom_font_heading %}
      {% when 'ivyoradisplay' %}
        :root {
          --font-heading--family: 'IvyOraDisplay', sans-serif;
          --font-heading--weight: 300;
          --font-accent--family: 'IvyOraDisplay', sans-serif;
          --font-accent--weight: 700;
        }
    {% endcase %}
  </style>
{% endif %}
