{%- doc -%}
  Fair Harbor design refresh 2026: shared design tokens, fonts and base utilities
  used by every `fh-*` section. Values come from the Figma file
  "Anatta x FH Design Refresh 2026" (node 1:2).
{%- enddoc -%}

{%- liquid
  assign serif = settings.fh_serif_font
  assign sans = settings.fh_sans_font
  assign sans_bold = sans | font_modify: 'weight', 'bold'
-%}

<style>
  {{ serif | font_face: font_display: 'swap' }}
  {{ sans | font_face: font_display: 'swap' }}
  {%- if sans_bold -%}{{ sans_bold | font_face: font_display: 'swap' }}{%- endif -%}

  {%- if settings.fh_use_licensed_fonts -%}
    {%- liquid
      assign ext = ".woff2"
      assign arizona = "abc-arizona-regular" | append: ext | asset_url
      assign diatype = "abc-diatype-regular" | append: ext | asset_url
      assign diatype_bold = "abc-diatype-bold" | append: ext | asset_url
    -%}
  @font-face { font-family: "ABC Arizona"; src: url("{{ arizona }}") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "ABC Diatype"; src: url("{{ diatype }}") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "ABC Diatype"; src: url("{{ diatype_bold }}") format("woff2"); font-weight: 700; font-display: swap; }
  {%- endif %}

  :root {
    /* Colour */
    --fh-navy: #00165a;
    --fh-blue: #223d72;
    --fh-slate: #436389;
    --fh-sky: #c8d5e4;
    --fh-sand: #f4f0ed;
    --fh-cream: #fcfbfa;
    --fh-sage: #9baf8f;
    --fh-sage-dark: #869e77;
    --fh-rust: #af5312;
    --fh-ink: #1c1917;
    --fh-white: #ffffff;

    /* Type */
    --fh-font-serif: {% if settings.fh_use_licensed_fonts %}'ABC Arizona', {% endif %}{{ serif.family }}, {{ serif.fallback_families }};
    --fh-font-sans: {% if settings.fh_use_licensed_fonts %}'ABC Diatype', {% endif %}{{ sans.family }}, {{ sans.fallback_families }};

    /* Layout */
    --fh-gutter: 64px;
    --fh-gutter-sm: 40px;
    --fh-max: 1512px;
    --fh-ease: cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  @media screen and (max-width: 989px) {
    :root { --fh-gutter: 24px; --fh-gutter-sm: 20px; }
  }

  .fh { font-family: var(--fh-font-sans); color: var(--fh-navy); -webkit-font-smoothing: antialiased; }
  .fh *, .fh *::before, .fh *::after { box-sizing: border-box; }
  .fh :where(h1, h2, h3, h4, p, ul, ol, figure) { margin: 0; padding: 0; }
  .fh :where(ul, ol) { list-style: none; }
  .fh :where(a) { color: inherit; text-decoration: none; }
  .fh :where(button) { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  .fh :where(img) { display: block; max-width: 100%; }
  .fh-icon { display: block; width: 24px; height: 24px; flex: none; }

  /* Type scale (desktop values from Figma, fluid down to mobile) */
  .fh-display { font-family: var(--fh-font-serif); font-weight: 400; font-size: clamp(48px, 6.35vw, 96px); line-height: 1.083; letter-spacing: -0.03em; }
  .fh-h2 { font-family: var(--fh-font-serif); font-weight: 400; font-size: clamp(28px, 2.65vw, 40px); line-height: 1.2; letter-spacing: -0.02em; }
  .fh-h3 { font-family: var(--fh-font-serif); font-weight: 400; font-size: clamp(24px, 2.12vw, 32px); line-height: 1.25; letter-spacing: -0.02em; }
  .fh-h4 { font-family: var(--fh-font-serif); font-weight: 400; font-size: 24px; line-height: 32px; letter-spacing: -0.02em; }
  .fh-eyebrow { font-family: var(--fh-font-sans); font-weight: 700; font-size: 12px; line-height: 16px; letter-spacing: 2px; text-transform: uppercase; }
  .fh-body-lg { font-size: 18px; line-height: 28px; }
  .fh-body { font-size: 16px; line-height: 24px; }
  .fh-body-sm { font-size: 14px; line-height: 20px; }
  .fh-caption { font-size: 12px; line-height: 16px; }

  /* Pill button (Figma: 48px tall, 32px side padding, fully rounded) */
  .fh-btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 4px 32px;
    border-radius: 9999px; border: 1px solid transparent; font-family: var(--fh-font-sans); font-weight: 700;
    font-size: 12px; line-height: 16px; letter-spacing: 2px; text-transform: uppercase; text-align: center;
    transition: background-color 0.2s var(--fh-ease), color 0.2s var(--fh-ease), border-color 0.2s var(--fh-ease);
  }
  .fh-btn--light { background: var(--fh-white); color: var(--fh-navy); }
  .fh-btn--light:hover { background: var(--fh-navy); color: var(--fh-white); }
  .fh-btn--dark { background: var(--fh-navy); color: var(--fh-white); }
  .fh-btn--dark:hover { background: var(--fh-blue); }
  .fh-btn--outline { border-color: currentColor; background: transparent; }
  .fh-btn--outline:hover { background: var(--fh-navy); border-color: var(--fh-navy); color: var(--fh-white); }

  /* Round carousel arrows (40px, 1px navy stroke) */
  .fh-arrows { display: flex; gap: 16px; }
  .fh-arrow {
    display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px;
    border-radius: 9999px; border: 1px solid var(--fh-navy); color: var(--fh-navy); transition: opacity 0.2s, background-color 0.2s, color 0.2s;
  }
  .fh-arrow:hover:not([disabled]) { background: var(--fh-navy); color: var(--fh-white); }
  .fh-arrow[disabled] { opacity: 0.4; cursor: default; }
  .fh-arrow--next .fh-icon { transform: scaleX(-1); }

  /* Horizontal scroll track used by carousels */
  .fh-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .fh-track::-webkit-scrollbar { display: none; }
  .fh-track > * { scroll-snap-align: start; flex: none; }

  .fh-link-underline { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .fh-visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (prefers-reduced-motion: reduce) {
    .fh *, .fh *::before, .fh *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
  }
</style>
