{% doc %}
  Mobile navigation drawer for custom header.

  @param center_menu {Object} Linklist object for center navigation
  @param right_menu {Object} Linklist object for right navigation
  @param color_scheme {String} Color scheme ID (default: 'scheme-5')

  @example
    {% render 'custom-header-drawer',
       center_menu: linklists['main-menu'],
       right_menu: linklists['right-menu'],
       color_scheme: section.settings.color_scheme
    %}
{% enddoc %}

{% liquid
  assign color_scheme = color_scheme | default: 'scheme-5'
%}

<div
  class="custom-header-drawer color-{{ color_scheme }}"
  id="custom-header-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'sections.custom_header.menu_label' | t }}"
>
  <div class="custom-header-drawer__overlay" data-drawer-overlay></div>
  <div class="custom-header-drawer__panel">
    <div class="custom-header-drawer__header">
      <button
        type="button"
        class="custom-header-drawer__close"
        data-drawer-close
        aria-label="{{ 'sections.custom_header.close_menu' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>

    <nav class="custom-header-drawer__nav" aria-label="{{ 'sections.custom_header.menu_label' | t }}">
      {% if center_menu != blank and center_menu.links.size > 0 %}
        <div class="custom-header-drawer__menu-group">
          <ul class="custom-header-drawer__list" role="list">
            {% for link in center_menu.links %}
              <li class="custom-header-drawer__item">
                <a
                  href="{{ link.url }}"
                  class="custom-header-drawer__link"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {{ link.title | escape }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if right_menu != blank and right_menu.links.size > 0 %}
        <div class="custom-header-drawer__menu-group">
          <ul class="custom-header-drawer__list" role="list">
            {% for link in right_menu.links %}
              <li class="custom-header-drawer__item">
                <a
                  href="{{ link.url }}"
                  class="custom-header-drawer__link"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {{ link.title | escape }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </nav>
  </div>
</div>

<style>
  .custom-header-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    visibility: hidden;
  }

  .custom-header-drawer.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  .custom-header-drawer__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .custom-header-drawer.is-open .custom-header-drawer__overlay {
    opacity: 1;
  }

  .custom-header-drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background-color: var(--color-background);
    color: var(--color-foreground);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
    padding: var(--padding-lg);
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .custom-header-drawer.is-open .custom-header-drawer__panel {
    transform: translateX(0);
  }

  .custom-header-drawer__header {
    display: flex;
    justify-content: flex-end;
  }

  .custom-header-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: none;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .custom-header-drawer__close svg {
    width: 20px;
    height: 20px;
  }

  .custom-header-drawer__nav {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
  }

  .custom-header-drawer__menu-group {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .custom-header-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .custom-header-drawer__link {
    display: block;
    padding-block: var(--padding-2xs);
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-foreground);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .custom-header-drawer__link:hover {
    opacity: 0.7;
  }

  @media screen and (min-width: 750px) {
    .custom-header-drawer {
      display: none;
    }
  }
</style>
