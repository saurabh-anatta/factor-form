{%- doc -%}
  Fair Harbor design-refresh 2026 foundation: fonts, design tokens and shared
  component styles used by every `fh-*` section. Rendered once in layout/theme.liquid.

  Brand fonts in Figma are ABC Arizona (serif) and ABC Diatype (sans). They are
  commercial, so the stacks below name them first and fall back to the
  open-source Newsreader and Inter (Google Fonts). To use the licensed fonts,
  upload the .woff2 files to assets/ and add @font-face rules here.
{%- enddoc -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400&display=swap"
>

<style>
  :root {
    --fh-navy: #00165a;
    --fh-blue: #436389;
    --fh-blue-deep: #223d72;
    --fh-blue-light: #c8d5e4;
    --fh-sand: #f4f0ed;
    --fh-shell: #fcfbfa;
    --fh-sage: #9baf8f;
    --fh-sage-deep: #869e77;
    --fh-rust: #af5312;
    --fh-ink: #1c1917;
    --fh-white: #ffffff;

    --fh-serif: 'ABC Arizona Flare', 'Newsreader', Georgia, 'Times New Roman', serif;
    --fh-sans: 'ABC Diatype', 'Inter', system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;

    --fh-gutter: 64px;
    --fh-gutter-sm: 40px;
  }

  @media screen and (max-width: 989px) {
    :root { --fh-gutter: 24px; --fh-gutter-sm: 20px; }
  }

  .fh { font-family: var(--fh-sans); color: var(--fh-navy); -webkit-font-smoothing: antialiased; }
  .fh *, .fh *::before, .fh *::after { box-sizing: border-box; }
  .fh :where(h1, h2, h3, h4, p, ul, ol, figure) { margin: 0; padding: 0; }
  .fh :where(ul, ol) { list-style: none; }
  .fh :where(a) { color: inherit; text-decoration: none; }
  .fh :where(button) { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  .fh img { display: block; max-width: 100%; }

  /* Typography — values taken from the Figma text styles */
  .fh-display { font-family: var(--fh-serif); font-weight: 400; font-size: 96px; line-height: 104px; letter-spacing: -2.88px; }
  .fh-h2 { font-family: var(--fh-serif); font-weight: 400; font-size: 40px; line-height: 48px; letter-spacing: -0.8px; }
  .fh-h3 { font-family: var(--fh-serif); font-weight: 400; font-size: 32px; line-height: 40px; letter-spacing: -0.64px; }
  .fh-h4 { font-family: var(--fh-serif); font-weight: 400; font-size: 24px; line-height: 32px; letter-spacing: -0.48px; }
  .fh-lead { font-size: 18px; line-height: 28px; }
  .fh-body { font-size: 16px; line-height: 24px; }
  .fh-small { font-size: 14px; line-height: 20px; }
  .fh-caption { font-size: 12px; line-height: 16px; }
  .fh-eyebrow { font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }

  @media screen and (max-width: 989px) {
    .fh-display { font-size: 56px; line-height: 60px; letter-spacing: -1.68px; }
    .fh-h2 { font-size: 32px; line-height: 40px; letter-spacing: -0.64px; }
    .fh-h3 { font-size: 28px; line-height: 36px; }
    .fh-lead { font-size: 16px; line-height: 24px; }
  }

  /* Pill button (Figma "Link": 48px tall, 32px side padding, fully rounded) */
  .fh-btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; padding: 4px 32px; border-radius: 9999px;
    background: var(--fh-white); color: var(--fh-navy);
    font-family: var(--fh-sans); font-size: 12px; line-height: 16px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase; white-space: nowrap;
    transition: background-color .2s ease, color .2s ease;
  }
  .fh-btn:hover { background: var(--fh-navy); color: var(--fh-white); }
  .fh-btn--navy { background: var(--fh-navy); color: var(--fh-white); }
  .fh-btn--navy:hover { background: var(--fh-blue-deep); }

  /* Round arrow buttons used by every carousel */
  .fh-arrows { display: flex; gap: 16px; }
  .fh-arrow {
    width: 40px; height: 40px; border-radius: 9999px; border: 1px solid var(--fh-navy);
    display: inline-flex; align-items: center; justify-content: center; color: var(--fh-navy);
    transition: opacity .2s ease, background-color .2s ease, color .2s ease;
  }
  .fh-arrow svg { width: 24px; height: 24px; }
  .fh-arrow:not([disabled]):hover { background: var(--fh-navy); color: var(--fh-white); }
  .fh-arrow[disabled] { opacity: .4; cursor: default; }

  /* Horizontal scroll-snap track for <fh-carousel> */
  .fh-track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .fh-track::-webkit-scrollbar { display: none; }
  .fh-track > * { scroll-snap-align: start; flex: 0 0 auto; }

  .fh-media { position: relative; overflow: hidden; background: var(--fh-sand); }
  .fh-media > img, .fh-media > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .fh-visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>

<script src="{{ 'fh-components.js' | asset_url }}" type="module"></script>
