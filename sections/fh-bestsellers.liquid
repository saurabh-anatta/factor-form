{%- comment -%} Figma 1:167 — "Shop bestsellers": tabs + product carousel {%- endcomment -%}
{%- liquid
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign card_blocks = section.blocks | where: 'type', 'card'
-%}

<section class="fh fh-best" style="--fh-best-bg: {{ section.settings.background }};">
  <fh-tabs>
    <fh-carousel class="fh-best__inner">
      <div class="fh-best__head">
        <h2 class="fh-best__title fh-h2">{{ section.settings.heading }}</h2>
        <div class="fh-arrows fh-best__arrows">
          <button type="button" class="fh-arrow" data-fh-prev aria-label="Previous slide">{{ 'fh-icon-arrow-left.svg' | inline_asset_content }}</button>
          <button type="button" class="fh-arrow" data-fh-next aria-label="Next slide">{{ 'fh-icon-arrow-right.svg' | inline_asset_content }}</button>
        </div>
      </div>

      {%- if tab_blocks.size > 1 -%}
        <div class="fh-best__tabs" role="tablist" aria-label="Product categories">
          {%- for tab in tab_blocks -%}
            <button
              type="button"
              role="tab"
              class="fh-best__tab fh-small"
              data-fh-tab="{{ tab.settings.label | handleize }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ tab.shopify_attributes }}
            >
              {{- tab.settings.label -}}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="fh-best__track fh-track" data-fh-track>
        {%- for tab in tab_blocks -%}
          {%- assign key = tab.settings.label | handleize -%}
          {%- if tab.settings.collection != blank and tab.settings.collection.products_count > 0 -%}
            {%- for product in tab.settings.collection.products limit: section.settings.max_products -%}
              {% render 'fh-product-card', product: product, tabs: key, eager: false %}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Manual cards: shown under every tab listed in their "Tabs" setting {%- endcomment -%}
        {%- for card in card_blocks -%}
          {%- liquid
            assign keys = ''
            assign names = card.settings.tabs | split: ','
            for n in names
              assign k = n | strip | handleize
              for tab in tab_blocks
                assign tk = tab.settings.label | handleize
                if tk == k
                  if tab.settings.collection == blank or tab.settings.collection.products_count == 0
                    assign keys = keys | append: k | append: ','
                  endif
                endif
              endfor
            endfor
            if tab_blocks.size == 0
              assign keys = 'all'
            endif
          -%}
          {%- if keys != blank -%}
            {% render 'fh-product-card', block: card, tabs: keys %}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <div class="fh-best__cta">
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="fh-best__cta-link fh-body">{{ section.settings.cta_label }}</a>
        </div>
      {%- endif -%}
    </fh-carousel>
  </fh-tabs>
</section>

{% stylesheet %}
  .fh-best { background: var(--fh-best-bg, #fff); padding: 25px 0; }
  .fh-best__inner { display: block; padding: 0 0 16px var(--fh-gutter-sm); }
  .fh-best__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; padding-right: var(--fh-gutter-sm); }
  .fh-best__title { letter-spacing: 0; }
  .fh-best__tabs { display: flex; flex-wrap: wrap; gap: 16px; padding-top: 20px; }
  .fh-best__tab {
    min-height: 42px; padding: 10px 15px; border-radius: 9999px; color: #000;
    background: var(--fh-shell); border: 1px solid var(--fh-sand); transition: background-color .2s ease, border-color .2s ease;
  }
  .fh-best__tab:hover { border-color: var(--fh-blue); }
  .fh-best__tab[aria-selected='true'] { background: var(--fh-blue-light); border-color: var(--fh-blue); }
  .fh-best__track { margin-top: 24px; scroll-padding-left: 0; }
  .fh-best__track > [hidden] { display: none; }
  .fh-best__cta { padding: 32px var(--fh-gutter-sm) 0 0; text-align: center; }
  .fh-best__cta-link { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .fh-best__cta-link:hover { color: var(--fh-blue); }

  .fh-card { width: 356px; padding-right: 16px; }
  .fh-card__media { display: block; aspect-ratio: 340 / 454; }
  .fh-card__media img { transition: transform .6s ease; }
  .fh-card__media:hover img { transform: scale(1.03); }
  .fh-card__badge { position: absolute; top: 0; left: 0; z-index: 1; background: var(--fh-blue-light); color: var(--fh-navy); padding: 3px 6px; font-size: 14px; line-height: 14px; }
  .fh-card__label { position: absolute; left: 0; bottom: 0; z-index: 1; background: #fff; color: var(--fh-sage-deep); padding: 3px 10px; font-size: 14px; line-height: 14px; }
  .fh-card__info { padding: 16px 0; }
  .fh-card__swatches { display: flex; align-items: center; gap: 16px; padding-bottom: 8px; min-height: 34px; }
  .fh-card__swatch { width: 20px; height: 20px; border-radius: 9999px; display: inline-flex; align-items: center; justify-content: center; flex: none; }
  .fh-card__swatch > span { width: 20px; height: 20px; border-radius: 9999px; background-size: cover; background-position: center; display: block; }
  .fh-card__swatch.is-selected { width: 26px; height: 26px; margin: -3px; padding: 2px; border: 1px solid #121211; }
  .fh-card__more { color: var(--fh-navy); }
  .fh-card__title { padding-bottom: 2px; font-weight: 400; color: var(--fh-navy); }
  .fh-card__subtitle { color: var(--fh-blue); padding-bottom: 3px; }
  .fh-card__price-row { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; }
  .fh-card__chips { display: inline-flex; gap: 8px; margin-left: 4px; }
  .fh-card__chip { display: inline-flex; align-items: center; height: 20px; padding: 2px 8px; border-radius: 60px; background: var(--fh-sand); color: var(--fh-ink); font-size: 12px; line-height: 12px; white-space: nowrap; }

  @media screen and (max-width: 749px) {
    .fh-best__arrows { display: none; }
    .fh-best__tabs { gap: 8px; overflow-x: auto; flex-wrap: nowrap; padding-right: 20px; scrollbar-width: none; }
    .fh-card { width: 72vw; max-width: 300px; padding-right: 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FH Bestsellers",
  "class": "fh-best-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop bestsellers" },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Shop Men’s Bestsellers" },
    { "type": "url", "id": "cta_link", "label": "Link" },
    { "type": "range", "id": "max_products", "label": "Products per collection tab", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Swim" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "When empty, manual cards tagged with this tab are shown" }
      ]
    },
    {
      "type": "card",
      "name": "Manual card",
      "settings": [
        { "type": "text", "id": "tabs", "label": "Tabs", "info": "Comma-separated tab labels, e.g. Swim, Tops", "default": "Swim" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_image", "label": "Placeholder image (theme asset)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Bayberry Trunk" },
        { "type": "text", "id": "subtitle", "label": "Color / subtitle", "default": "Light Blue Seersucker" },
        { "type": "text", "id": "price", "label": "Price", "default": "$88" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Bestseller" },
        { "type": "text", "id": "image_label", "label": "Image label", "default": "Personalize It" },
        { "type": "text", "id": "chip_1", "label": "Chip 1", "default": "Bundle & Save" },
        { "type": "text", "id": "chip_2", "label": "Chip 2", "default": "Personalize It" },
        { "type": "text", "id": "swatches", "label": "Swatches", "info": "Comma-separated colors (#hex) or theme asset images" },
        { "type": "number", "id": "swatch_selected", "label": "Selected swatch (position)", "default": 1 },
        { "type": "number", "id": "more_count", "label": "More colors count", "default": 9 }
      ]
    }
  ],
  "presets": [
    {
      "name": "FH Bestsellers",
      "blocks": [
        { "type": "tab", "settings": { "label": "Swim" } },
        { "type": "tab", "settings": { "label": "Tops" } },
        { "type": "tab", "settings": { "label": "Bottoms" } },
        { "type": "card", "settings": { "fallback_image": "fh-prod1.jpg" } }
      ]
    }
  ]
}
{% endschema %}
