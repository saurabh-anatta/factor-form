{%- comment -%}
  Shop bestsellers (Design refresh 2026, Figma node 1-167)
  Tabbed product carousel. Each tab block points at a collection.
{%- endcomment -%}

{{ 'fh-bestsellers.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'fh-bestsellers.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% style %}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  #FhBestsellers-{{ section.id }} {
    --fh-bs-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --fh-bs-padding-top: {{ section.settings.padding_top }}px;
    --fh-bs-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{%- liquid
  assign heading_id = 'FhBestsellersHeading-' | append: section.id
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign pill_tags = section.settings.pill_tags | split: ','
  assign badge_tag = section.settings.badge_tag | strip | downcase
  assign image_label_tag = section.settings.image_label_tag | strip | downcase
-%}

<fh-bestsellers
  id="FhBestsellers-{{ section.id }}"
  class="fh-bestsellers"
  aria-labelledby="{{ heading_id }}"
>
  <div class="fh-bestsellers__inner">
    <div class="fh-bestsellers__header">
      <h2
        id="{{ heading_id }}"
        class="fh-bestsellers__heading"
      >
        {{ section.settings.heading | escape }}
      </h2>

      <div class="fh-bestsellers__arrows">
        <button
          type="button"
          class="fh-bestsellers__arrow"
          ref="prevButton"
          on:click="/scrollPrev"
          aria-label="Previous slide"
          disabled
        >
          <svg
            aria-hidden="true"
            focusable="false"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path d="M21 12H3M3 12L9.5 5.5M3 12L9.5 18.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="fh-bestsellers__arrow"
          ref="nextButton"
          on:click="/scrollNext"
          aria-label="Next slide"
        >
          <svg
            aria-hidden="true"
            focusable="false"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path d="M3 12H21M21 12L14.5 5.5M21 12L14.5 18.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    {%- if tab_blocks.size > 1 -%}
      <div
        class="fh-bestsellers__tabs"
        role="tablist"
        aria-label="{{ section.settings.heading | escape }}"
      >
        {%- for block in tab_blocks -%}
          <button
            type="button"
            role="tab"
            class="fh-bestsellers__tab"
            id="FhBestsellersTab-{{ block.id }}"
            aria-controls="FhBestsellersPanel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            ref="tabs[]"
            on:click="/selectTab"
            on:keydown="/onTabKeydown"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label | escape }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in tab_blocks -%}
      {%- assign collection = block.settings.collection -%}
      <div
        class="fh-bestsellers__panel"
        id="FhBestsellersPanel-{{ block.id }}"
        ref="panels[]"
        {% if tab_blocks.size > 1 %}
          role="tabpanel"
          aria-labelledby="FhBestsellersTab-{{ block.id }}"
        {% endif %}
        {% unless forloop.first %}
          hidden
        {% endunless %}
      >
        <div
          class="fh-bestsellers__track"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ block.settings.label | escape }}"
          tabindex="-1"
          ref="tracks[]"
        >
          {%- if collection != blank and collection.products.size > 0 -%}
            {%- for product in collection.products limit: block.settings.limit -%}
              {%- liquid
                assign color_option = nil
                for option in product.options_with_values
                  assign option_name = option.name | downcase
                  if option_name == 'color' or option_name == 'colour'
                    assign color_option = option
                    break
                  endif
                endfor

                assign subtitle = ''
                if color_option
                  assign subtitle = color_option.selected_value
                elsif product.type != blank
                  assign subtitle = product.type
                endif

                assign product_tags = product.tags | join: '|' | downcase | split: '|'
                assign slide_label = forloop.index | append: ' of ' | append: forloop.length
              -%}
              <div
                class="fh-bestsellers__slide"
                role="group"
                aria-roledescription="slide"
                aria-label="{{ slide_label }}"
              >
                <a
                  href="{{ product.url }}"
                  class="fh-bestsellers__media"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {%- if product.featured_media -%}
                    {{
                      product.featured_media
                      | image_url: width: 720
                      | image_tag:
                        loading: 'lazy',
                        widths: '340, 480, 680, 720',
                        sizes: '(min-width: 750px) 340px, 75vw',
                        class: 'fh-bestsellers__image',
                        alt: product.featured_media.alt
                    }}
                  {%- else -%}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'fh-bestsellers__image' }}
                  {%- endif -%}
                </a>

                {%- if badge_tag != blank and product_tags contains badge_tag -%}
                  <span class="fh-bestsellers__badge">{{ section.settings.badge_tag | strip | escape }}</span>
                {%- elsif forloop.index <= section.settings.auto_badge_count -%}
                  <span class="fh-bestsellers__badge">{{ section.settings.badge_tag | strip | escape }}</span>
                {%- endif -%}

                {%- if image_label_tag != blank and product_tags contains image_label_tag -%}
                  <span class="fh-bestsellers__image-label">{{ section.settings.image_label_tag | strip | escape }}</span>
                {%- endif -%}

                <div class="fh-bestsellers__info">
                  {%- if color_option and color_option.values.size > 1 -%}
                    {%- liquid
                      assign max_swatches = 6
                      assign extra = color_option.values.size | minus: max_swatches
                    -%}
                    <ul
                      class="fh-bestsellers__swatches"
                      aria-label="{{ color_option.name | escape }}"
                    >
                      {%- for value in color_option.values limit: max_swatches -%}
                        {%- liquid
                          assign swatch_style = ''
                          if value.swatch.image
                            assign swatch_url = value.swatch.image | image_url: width: 40
                            assign swatch_style = 'background-image: url(' | append: swatch_url | append: ');'
                          elsif value.swatch.color
                            assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
                          else
                            assign swatch_style = 'background-color: ' | append: value | handleize | append: ';'
                          endif
                        -%}
                        <li
                          class="fh-bestsellers__swatch{% if value == color_option.selected_value %} fh-bestsellers__swatch--selected{% endif %}"
                          title="{{ value | escape }}"
                        >
                          <span
                            class="fh-bestsellers__swatch-color"
                            style="{{ swatch_style }}"
                          ></span>
                          <span class="visually-hidden">{{ value | escape }}</span>
                        </li>
                      {%- endfor -%}
                      {%- if extra > 0 -%}
                        <li class="fh-bestsellers__swatch-more">
                          <a href="{{ product.url }}">
                            +{{ extra }}<span class="visually-hidden"> more colors</span>
                          </a>
                        </li>
                      {%- endif -%}
                    </ul>
                  {%- endif -%}

                  <p class="fh-bestsellers__title">
                    <a href="{{ product.url }}">{{ product.title | escape }}</a>
                  </p>

                  {%- if subtitle != blank -%}
                    <p class="fh-bestsellers__subtitle">{{ subtitle | escape }}</p>
                  {%- endif -%}

                  <div class="fh-bestsellers__price-row">
                    <span class="fh-bestsellers__price">
                      {%- if product.price_varies -%}
                        {%- assign price_min = product.price_min | money_without_trailing_zeros -%}
                        {{ 'content.price_from' | t: price: price_min -}}
                      {%- else -%}
                        {{ product.price | money_without_trailing_zeros }}
                      {%- endif -%}
                    </span>
                    {%- if product.compare_at_price > product.price -%}
                      <s class="fh-bestsellers__compare">
                        <span class="visually-hidden">Regular price</span>
                        {{ product.compare_at_price | money_without_trailing_zeros }}
                      </s>
                    {%- endif -%}

                    {%- capture pills -%}
                      {%- for pill in pill_tags -%}
                        {%- assign pill_name = pill | strip -%}
                        {%- assign pill_key = pill_name | downcase -%}
                        {%- if pill_name != blank and product_tags contains pill_key -%}
                          <li class="fh-bestsellers__pill">{{ pill_name | escape }}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endcapture -%}
                    {%- if pills != blank -%}
                      <ul class="fh-bestsellers__pills">
                        {{ pills }}
                      </ul>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div
                class="fh-bestsellers__slide"
                role="group"
                aria-roledescription="slide"
                aria-label="{{ i }} of 4"
              >
                <div class="fh-bestsellers__media">
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'fh-bestsellers__image' }}
                </div>
                <div class="fh-bestsellers__info">
                  <p class="fh-bestsellers__title">Product title</p>
                  <p class="fh-bestsellers__subtitle">Choose a collection for this tab</p>
                  <div class="fh-bestsellers__price-row">
                    <span class="fh-bestsellers__price">{{ 8800 | money_without_trailing_zeros }}</span>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</fh-bestsellers>

{% schema %}
{
  "name": "Shop bestsellers",
  "tag": "section",
  "class": "section-fh-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop bestsellers"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n4"
    },
    {
      "type": "header",
      "content": "Product labels"
    },
    {
      "type": "text",
      "id": "badge_tag",
      "label": "Badge text / product tag",
      "info": "Shown top-left on products tagged with this text",
      "default": "Bestseller"
    },
    {
      "type": "range",
      "id": "auto_badge_count",
      "label": "Also show badge on the first N products",
      "min": 0,
      "max": 18,
      "step": 1,
      "default": 0
    },
    {
      "type": "text",
      "id": "image_label_tag",
      "label": "Image label / product tag",
      "info": "Shown bottom-left of the image on products tagged with this text",
      "default": "Personalize It"
    },
    {
      "type": "text",
      "id": "pill_tags",
      "label": "Pill tags",
      "info": "Comma-separated product tags shown as pills next to the price",
      "default": "Bundle & Save, Personalize It"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Swim"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "limit",
          "label": "Products to show",
          "min": 2,
          "max": 18,
          "step": 1,
          "default": 12
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop bestsellers",
      "blocks": [
        { "type": "tab", "settings": { "label": "Swim" } },
        { "type": "tab", "settings": { "label": "Tops" } },
        { "type": "tab", "settings": { "label": "Bottoms" } }
      ]
    }
  ]
}
{% endschema %}
