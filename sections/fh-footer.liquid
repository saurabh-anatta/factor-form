{%- comment -%} Figma 1:1774 — Footer {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign values = section.blocks | where: 'type', 'value'
  assign columns = section.blocks | where: 'type', 'column'
-%}

<div class="fh fh-footer" style="--fh-footer-bg: {{ s.background }};">
  {%- if values.size > 0 -%}
    <ul class="fh-footer__values" role="list">
      {%- for block in values -%}
        <li class="fh-footer__value" {{ block.shopify_attributes }}>
          <span class="fh-footer__value-icon">
            {% render 'fh-image', image: block.settings.image, fallback: block.settings.fallback_image, alt: '', sizes: '48px', width: 96, w: 48, h: 48 %}
          </span>
          <span class="fh-h4 fh-footer__value-text">{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <div class="fh-footer__main">
    <div class="fh-footer__left">
      <div class="fh-footer__signup">
        <h3 class="fh-footer__signup-title">{{ s.newsletter_heading }}</h3>
        {%- if s.newsletter_text != blank -%}<p class="fh-footer__signup-text fh-body">{{ s.newsletter_text }}</p>{%- endif -%}
        {%- form 'customer', id: 'FhFooterNewsletter', class: 'fh-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="fh-footer__form-msg fh-small" role="status">{{ s.newsletter_success }}</p>
          {%- else -%}
            <label for="FhFooterEmail" class="fh-visually-hidden">Email</label>
            <input
              id="FhFooterEmail"
              type="email"
              name="contact[email]"
              class="fh-footer__input fh-body"
              placeholder="{{ s.newsletter_placeholder }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="fh-footer__submit" aria-label="Subscribe to newsletter">
              {{ 'fh-icon-arrow-right.svg' | inline_asset_content }}
            </button>
            {%- if form.errors -%}
              <p class="fh-footer__form-msg fh-small" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      <ul class="fh-footer__social" role="list">
        {%- liquid
          assign networks = 'facebook,pinterest,linkedin,instagram' | split: ','
        -%}
        {%- for n in networks -%}
          {%- assign key = 'social_' | append: n -%}
          {%- assign url = s[key] -%}
          {%- if url != blank -%}
            <li>
              <a href="{{ url }}" class="fh-footer__social-link" target="_blank" rel="noopener" aria-label="Visit our {{ n | capitalize }} page">
                {{ 'fh-icon-' | append: n | append: '.svg' | inline_asset_content }}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if s.badge_image != blank or s.badge_fallback != blank -%}
        <a href="{{ s.badge_link | default: '#' }}" class="fh-footer__badge" aria-label="Visit certification details page">
          {% render 'fh-image', image: s.badge_image, fallback: s.badge_fallback, alt: 'Certification', sizes: '66px', width: 132, w: 66, h: 106 %}
        </a>
      {%- endif -%}
    </div>

    <div class="fh-footer__columns">
      {%- for block in columns -%}
        <div class="fh-footer__col" {{ block.shopify_attributes }}>
          <h3 class="fh-footer__col-title fh-body">{{ block.settings.heading }}</h3>
          <ul class="fh-footer__links" role="list">
            {%- if block.settings.menu != blank -%}
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}" class="fh-body">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign parts = line | strip | split: '|' -%}
                {%- if parts.size > 0 and parts.first != blank -%}
                  <li><a href="{{ parts.last | strip | default: '#' }}" class="fh-body">{{ parts.first | strip }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="fh-footer__legal fh-small">
    <span>© {{ 'now' | date: '%Y' }}, {{ s.copyright | default: shop.name }}</span>
    {%- assign legal = s.legal_links | newline_to_br | split: '<br />' -%}
    {%- for line in legal -%}
      {%- assign parts = line | strip | split: '|' -%}
      {%- if parts.size > 0 and parts.first != blank -%}
        {%- unless forloop.first %}<span class="fh-footer__sep" aria-hidden="true">|</span>{% endunless -%}
        <a href="{{ parts.last | strip | default: '#' }}">{{ parts.first | strip }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .fh-footer { background: var(--fh-footer-bg, #f4f0ed); padding: 64px var(--fh-gutter); color: var(--fh-navy); }
  .fh-footer__values { display: flex; justify-content: space-between; align-items: center; gap: 32px; padding: 16px 0; border-bottom: 1px solid var(--fh-blue-light); }
  .fh-footer__value { display: flex; align-items: center; gap: 16px; }
  .fh-footer__value-icon { width: 48px; height: 48px; display: inline-flex; align-items: center; justify-content: center; flex: none; }
  .fh-footer__value-icon img { width: 48px; height: 48px; object-fit: contain; }
  .fh-footer__value-text { color: var(--fh-blue-deep); white-space: nowrap; }

  .fh-footer__main { display: flex; justify-content: space-between; gap: 32px; padding-top: 48px; }
  .fh-footer__left { display: flex; flex-direction: column; gap: 24px; width: 399px; max-width: 100%; }
  .fh-footer__signup-title { font-family: var(--fh-serif); font-weight: 400; font-size: 18px; line-height: 28px; text-transform: uppercase; }
  .fh-footer__signup-text { padding-top: 8px; }
  .fh-footer__form { position: relative; width: 300px; max-width: 100%; margin-top: 8px; }
  .fh-footer__input {
    width: 100%; height: 56px; padding: 16px 48px 16px 16px; background: #fff; border: 1px solid transparent; border-radius: 0;
    color: var(--fh-navy); font-family: var(--fh-sans); outline: none;
  }
  .fh-footer__input::placeholder { color: var(--fh-blue); opacity: 1; }
  .fh-footer__input:focus-visible { border-color: var(--fh-navy); }
  .fh-footer__submit { position: absolute; top: 0; right: 16px; height: 56px; width: 24px; display: inline-flex; align-items: center; color: var(--fh-navy); }
  .fh-footer__submit svg { width: 24px; height: 24px; }
  .fh-footer__form-msg { padding-top: 8px; }
  .fh-footer__social { display: flex; gap: 8px; }
  .fh-footer__social-link { display: inline-flex; width: 24px; height: 24px; color: var(--fh-navy); }
  .fh-footer__social-link svg { width: 24px; height: 24px; }
  .fh-footer__social-link:hover { color: var(--fh-blue); }
  .fh-footer__badge { display: inline-block; width: 66px; }
  .fh-footer__badge img { width: 66px; height: auto; }

  .fh-footer__columns { display: flex; gap: 32px; }
  .fh-footer__col { width: 208px; }
  .fh-footer__col-title { color: var(--fh-navy); font-weight: 400; }
  .fh-footer__links { display: flex; flex-direction: column; gap: 8px; padding: 16px 0 8px; }
  .fh-footer__links a { color: var(--fh-blue-deep); }
  .fh-footer__links a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .fh-footer__legal { display: flex; flex-wrap: wrap; align-items: center; padding-top: 32px; }
  .fh-footer__legal > span:first-child { padding-right: 3px; margin-right: 4px; }
  .fh-footer__legal a { text-decoration: underline; text-underline-offset: 2px; }
  .fh-footer__sep { padding: 0 3px; }

  @media screen and (max-width: 1199px) {
    .fh-footer__values { flex-wrap: wrap; justify-content: flex-start; row-gap: 16px; }
    .fh-footer__value { flex: 1 1 calc(50% - 32px); }
  }
  @media screen and (max-width: 989px) {
    .fh-footer { padding: 48px 20px; }
    .fh-footer__main { flex-direction: column; gap: 40px; }
    .fh-footer__columns { flex-wrap: wrap; gap: 24px 32px; }
    .fh-footer__col { width: calc(50% - 16px); }
    .fh-footer__value-text { font-size: 18px; line-height: 24px; white-space: normal; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FH Footer",
  "class": "fh-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#f4f0ed" },
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "UNLOCK 15% OFF" },
    { "type": "text", "id": "newsletter_text", "label": "Text", "default": "Get early access to new drops, exclusive deals and more." },
    { "type": "text", "id": "newsletter_placeholder", "label": "Placeholder", "default": "Email address" },
    { "type": "text", "id": "newsletter_success", "label": "Success message", "default": "Thanks for subscribing!" },
    { "type": "header", "content": "Social" },
    { "type": "url", "id": "social_facebook", "label": "Facebook" },
    { "type": "url", "id": "social_pinterest", "label": "Pinterest" },
    { "type": "url", "id": "social_linkedin", "label": "LinkedIn" },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "header", "content": "Certification badge" },
    { "type": "image_picker", "id": "badge_image", "label": "Badge image" },
    { "type": "text", "id": "badge_fallback", "label": "Placeholder image (theme asset)", "default": "fh-cert.png" },
    { "type": "url", "id": "badge_link", "label": "Badge link" },
    { "type": "header", "content": "Legal" },
    { "type": "text", "id": "copyright", "label": "Copyright name", "default": "Fair Harbor" },
    { "type": "textarea", "id": "legal_links", "label": "Legal links", "info": "One per line: Label | URL", "default": "Privacy Policy | /policies/privacy-policy\nDo Not Sell | #\nTerms Of Service | /policies/terms-of-service\nManage Your Cookies | #" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon" },
        { "type": "text", "id": "fallback_image", "label": "Placeholder icon (theme asset)" },
        { "type": "text", "id": "text", "label": "Text", "default": "Signature Comfort" }
      ]
    },
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "textarea", "id": "links", "label": "Links (when no menu is selected)", "info": "One per line: Label | URL", "default": "Shop Men’s | /collections/all" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FH Footer",
      "blocks": [
        { "type": "value", "settings": { "text": "Signature Comfort", "fallback_image": "fh-val1.png" } },
        { "type": "column", "settings": { "heading": "Shop" } }
      ]
    }
  ]
}
{% endschema %}
