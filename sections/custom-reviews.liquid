{% liquid
  assign color_scheme = section.settings.color_scheme
  assign heading = section.settings.heading
%}

<custom-reviews-carousel>
  <div
    class="custom-reviews color-{{ color_scheme }}"
    style="
      --section-padding-top: {{ section.settings.padding-block-start }}px;
      --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    "
  >
    {%- comment -%} Stars bar {%- endcomment -%}
    <div class="custom-reviews__stars">
      <div class="custom-reviews__stars-icons" role="img" aria-label="{{ 'sections.custom_reviews.star_rating' | t }}">
        {%- for i in (1..5) -%}
          <svg class="custom-reviews__star" width="18" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M9 0L11.0206 5.52786H16.7552L12.0673 8.94427L14.0879 14.4721L9 11.0557L3.91214 14.4721L5.93274 8.94427L1.24484 5.52786H6.97937L9 0Z" fill="#EABD0A"/>
          </svg>
        {%- endfor -%}
      </div>
      {% if heading != blank %}
        <h2 class="custom-reviews__heading">{{ heading | escape }}</h2>
      {% endif %}
    </div>

    {%- comment -%} Reviews track {%- endcomment -%}
    <div class="custom-reviews__track" data-reviews-track>
      {%- for block in section.blocks -%}
        <div class="custom-reviews__item" data-reviews-item {{ block.shopify_attributes }}>
          <div class="custom-reviews__video">
            <div class="custom-reviews__circle">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 260 }}"
                  alt="{{ block.settings.author | escape }}"
                  width="130"
                  height="230"
                  loading="lazy"
                  class="custom-reviews__circle-image"
                >
              {%- endif -%}
            </div>
            {%- if block.settings.show_play_button -%}
              <button type="button" class="custom-reviews__play"{% if block.settings.video_url != blank %} data-video-url="{{ block.settings.video_url | escape }}"{% endif %} aria-label="{{ 'sections.custom_reviews.play_video' | t }}">
                <img
                  class="custom-reviews__play-desktop"
                  src="{{ 'play-2.svg' | asset_url }}"
                  alt=""
                  role="presentation"
                  width="40"
                  height="40"
                  loading="lazy"
                >
                <img
                  class="custom-reviews__play-mobile"
                  src="{{ 'play.svg' | asset_url }}"
                  alt=""
                  role="presentation"
                  width="32"
                  height="32"
                  loading="lazy"
                >
              </button>
            {%- endif -%}
          </div>
          <div class="custom-reviews__text">
            {%- if block.settings.quote != blank -%}
              <p class="custom-reviews__quote">{{ block.settings.quote | escape }}</p>
            {%- endif -%}
            <span class="custom-reviews__divider" aria-hidden="true"></span>
            {%- if block.settings.author != blank -%}
              <p class="custom-reviews__author">{{ block.settings.author | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Dot pagination (mobile only) {%- endcomment -%}
    <div class="custom-reviews__dots" aria-label="Review navigation">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="custom-reviews__dot{% if forloop.first %} custom-reviews__dot--active{% endif %}"
          data-reviews-dot="{{ forloop.index0 }}"
          aria-label="Go to review {{ forloop.index }}"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
        >
          <span class="custom-reviews__dot-indicator"></span>
        </button>
      {%- endfor -%}
    </div>

    {%- comment -%} Video popup dialog {%- endcomment -%}
    <dialog class="custom-reviews__dialog" data-reviews-dialog>
      <div class="custom-reviews__dialog-inner">
        <button type="button" class="custom-reviews__dialog-close" data-reviews-dialog-close aria-label="{{ 'sections.custom_reviews.close_video' | t }}">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M29.9999 10.0001L10 30M9.99992 10L29.9998 29.9999" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="custom-reviews__dialog-circle">
          <div class="custom-reviews__dialog-video" data-reviews-dialog-video></div>
        </div>
      </div>
    </dialog>
  </div>
</custom-reviews-carousel>

<script src="{{ 'custom-reviews.js' | asset_url }}" type="module"></script>

{% stylesheet %}
.custom-reviews {
  padding-block-start: var(--section-padding-top, 48px);
  padding-block-end: var(--section-padding-bottom, 48px);
}

/* Stars bar */
.custom-reviews__stars {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--gap-sm, 1rem);
  padding-block-end: 40px;
}

.custom-reviews__stars-icons {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}

.custom-reviews__star {
  display: block;
}

.custom-reviews__heading {
  font-family: var(--font-heading--family);
  font-style: var(--font-heading--style);
  font-weight: var(--font-heading--weight);
  font-size: 1.5rem;
  line-height: 2rem;
  color: rgb(var(--color-foreground));
  margin: 0;
}

/* Reviews track */
.custom-reviews__track {
  display: flex;
  flex-direction: row;
  gap: 32px;
  justify-content: space-between;
  padding-inline: 64px;
}

/* Review item */
.custom-reviews__item {
  display: flex;
  flex-direction: row;
  gap: var(--gap-sm, 1rem);
  padding-inline-end: 8px;
  flex: 1;
  min-width: 0;
}

/* Video circle */
.custom-reviews__video {
  position: relative;
  flex-shrink: 0;
}

.custom-reviews__circle {
  width: 108px;
  height: 108px;
  border-radius: 50%;
  overflow: hidden;
  background-color: #D9D9D9;
}

.custom-reviews__circle-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Play button */
.custom-reviews__play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-reviews__play-desktop {
  display: block;
}

.custom-reviews__play-mobile {
  display: none;
}

/* Text content */
.custom-reviews__text {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs, 0.75rem);
  justify-content: space-between;
  min-width: 0;
}

.custom-reviews__quote {
  font-family: var(--font-subheading--family);
  font-style: var(--font-subheading--style);
  font-weight: var(--font-subheading--weight);
  font-size: 1rem;
  line-height: 1.5rem;
  color: rgb(var(--color-foreground));
  margin: 0;
}

.custom-reviews__divider {
  display: block;
  width: 32px;
  height: 1px;
  background-color: #B5B5A0;
  flex-shrink: 0;
}

.custom-reviews__author {
  font-family: var(--font-body--family);
  font-style: var(--font-body--style);
  font-weight: var(--font-body--weight);
  font-size: 0.875rem;
  line-height: 1.25rem;
  color: #B5B5A0;
  margin: 0;
}

/* Dot pagination — hidden on desktop */
.custom-reviews__dots {
  display: none;
}

/* Video popup dialog */
.custom-reviews__dialog {
  border: none;
  background: none;
  padding: 0;
  max-width: none;
  max-height: none;
  overflow: visible;
}

.custom-reviews__dialog[open] {
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-reviews__dialog::backdrop {
  background: rgba(0, 0, 0, 0.85);
}

.custom-reviews__dialog-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-reviews__dialog-close {
  position: absolute;
  top: -20px;
  right: -20px;
  z-index: 2;
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s ease;
}

.custom-reviews__dialog-close:hover {
  opacity: 0.7;
}

.custom-reviews__dialog-circle {
  width: 360px;
  height: 360px;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  background-color: #141414;
}

.custom-reviews__dialog-video {
  width: 100%;
  height: 100%;
  position: relative;
}

.custom-reviews__dialog-video iframe {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200%;
  height: 200%;
  transform: translate(-50%, -50%);
  border: none;
}

/* Mobile styles */
@media screen and (max-width: 749px) {
  .custom-reviews__stars {
    flex-direction: column;
    gap: var(--gap-xs, 0.75rem);
    padding: 40px 16px 24px 16px;
    padding-block-end: 24px;
  }

  .custom-reviews__heading {
    text-align: center;
  }

  .custom-reviews__star {
    width: 13px;
    height: 12px;
  }

  /* Track becomes horizontal scroller */
  .custom-reviews__track {
    display: flex;
    flex-direction: row;
    gap: 24px;
    justify-content: flex-start;
    padding-inline: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .custom-reviews__track::-webkit-scrollbar {
    display: none;
  }

  /* Each item takes full width on mobile */
  .custom-reviews__item {
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xs, 0.75rem);
    padding-inline-end: 0;
    min-width: calc(100vw - 32px);
    flex: 0 0 calc(100vw - 32px);
    scroll-snap-align: center;
  }

  /* Smaller circle on mobile */
  .custom-reviews__circle {
    width: 96px;
    height: 96px;
  }

  /* Play button sizing on mobile */
  .custom-reviews__play-desktop {
    display: none;
  }

  .custom-reviews__play-mobile {
    display: block;
  }

  /* Text centered on mobile */
  .custom-reviews__text {
    align-items: center;
    text-align: center;
  }

  .custom-reviews__author {
    font-size: 0.75rem;
    line-height: 1rem;
  }

  /* Show dot pagination on mobile */
  .custom-reviews__dots {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: var(--gap-2xs, 0.5rem);
    padding-block-start: 24px;
  }

  .custom-reviews__dot {
    background: none;
    border: none;
    padding: var(--padding-xs, 0.5rem) var(--padding-3xs, 0.125rem);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-reviews__dot-indicator {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #80806F;
    transition: all 0.2s ease;
  }

  .custom-reviews__dot--active .custom-reviews__dot-indicator {
    width: 24px;
    height: 8px;
    border-radius: 4px;
    background: linear-gradient(to right, #FFFFFF 54%, #80806F 54%);
  }

  .custom-reviews__dialog-circle {
    width: 280px;
    height: 280px;
  }

  .custom-reviews__dialog-close {
    top: -16px;
    right: -8px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_reviews",
  "tag": "section",
  "class": "custom-reviews-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Over 5,000 5-stars reviews on Trustpilot"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "review-item",
      "name": "t:names.review_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "t:settings.quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:settings.author"
        },
        {
          "type": "checkbox",
          "id": "show_play_button",
          "label": "t:settings.show_play_button",
          "default": true
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "t:settings.video_url",
          "info": "t:settings.video_url_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_reviews",
