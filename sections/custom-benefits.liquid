            "description_mobile": "No added sugar\u2014keto-friendly and free of unnecessary ingredients",
            "icon_desktop": "icon-2-quality-ingredients-2.svg",
            "icon_mobile": "icon-2-quality-ingredients.svg"
          }
        },
        {
