<div
  class="custom-certified"
  style="
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --certified-bg: {{ section.settings.background_color }};
  "
>
  <div class="custom-certified__container">
    {% if section.settings.heading != blank %}
      <h2 class="custom-certified__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="custom-certified__points">
      {% for block in section.blocks %}
        <div class="custom-certified__point" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              class="custom-certified__image"
              src="{{ block.settings.image | image_url: width: 296 }}"
              alt="{{ block.settings.heading | escape }}"
              width="148"
              height="74"
              loading="lazy"
            >
          {% endif %}
          <div class="custom-certified__content">
            {% if block.settings.heading != blank %}
              <h3 class="custom-certified__item-heading">{{ block.settings.heading | escape }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="custom-certified__description">{{ block.settings.description | escape }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
.custom-certified {
  padding-block-start: var(--section-padding-top, 80px);
  padding-block-end: var(--section-padding-bottom, 80px);
  padding-inline: 64px;
  background-color: var(--certified-bg, #FFFFFF);
}

.custom-certified__container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-2xl, 4rem);
  max-width: var(--normal-page-width, 120rem);
  margin-inline: auto;
}

.custom-certified__heading {
  font-family: var(--font-heading--family);
  font-weight: var(--font-heading--weight, 300);
  font-size: 48px;
  line-height: 56px;
  letter-spacing: 0;
  color: #141414;
  text-align: center;
  margin: 0;
}

.custom-certified__points {
  display: flex;
  flex-direction: row;
  gap: 32px;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.custom-certified__point {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24px;
  flex: 1;
  max-width: 328px;
}

.custom-certified__image {
  display: block;
  width: 148px;
  height: 74px;
  object-fit: contain;
  flex-shrink: 0;
}

.custom-certified__content {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.custom-certified__item-heading {
  font-family: var(--font-subheading--family);
  font-weight: 600;
  font-size: 20px;
  line-height: 28px;
  letter-spacing: 0;
  color: #141414;
  text-align: center;
  margin: 0;
}

.custom-certified__description {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 18px;
  line-height: 28px;
  letter-spacing: 0;
  color: #121211;
  text-align: center;
  margin: 0;
}

@media screen and (max-width: 749px) {
  .custom-certified {
    padding-block-start: 48px;
    padding-block-end: 48px;
    padding-inline: 16px;
  }

  .custom-certified__container {
    gap: 32px;
    align-items: flex-start;
  }

  .custom-certified__heading {
    font-size: 32px;
    line-height: 40px;
    text-align: start;
  }

  .custom-certified__points {
    flex-direction: column;
    gap: 32px;
    align-items: center;
  }

  .custom-certified__point {
    max-width: none;
    gap: 16px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_certified",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "The Factor Standard"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "certified-item",
      "name": "t:names.certified_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:settings.description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_certified",
      "blocks": [
        {
          "type": "certified-item",
          "settings": {
            "heading": "Pure Ingredients",
            "description": "Lorem ipsum dolor sit amet consectetur adipiscing elit."
          }
        },
        {
          "type": "certified-item",
          "settings": {
            "heading": "Expert-Crafted Blends",
            "description": "Lorem ipsum dolor sit amet consectetur adipiscing elit."
          }
        },
        {
          "type": "certified-item",
          "settings": {
            "heading": "Transparent and Clean Labels",
            "description": "Lorem ipsum dolor sit amet consectetur adipiscing elit."
          }
        }
      ]
    }
  ]
}
{% endschema %}
