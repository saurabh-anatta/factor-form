{%- comment -%}
  Fair Harbor announcement bar (Figma 1:2166).
  Sage bar, 32px tall, with rotating messages.
{%- endcomment -%}

{%- liquid
  assign announcements = section.blocks | where: 'type', 'announcement'
-%}

{%- if announcements.size > 0 -%}
  <div
    class="fh fh-announce"
    style="--fh-announce-bg: {{ section.settings.background }}; --fh-announce-fg: {{ section.settings.text_color }};"
  >
    <fh-announcements class="fh-announce__inner" data-speed="{{ section.settings.speed }}" role="region" aria-roledescription="carousel" aria-label="{{ 'fh.announcements' | t }}">
      {%- if announcements.size > 1 -%}
        <button type="button" class="fh-announce__nav fh-announce__nav--prev" data-prev aria-label="{{ 'fh.previous' | t }}">
          {%- render 'fh-icon', name: 'arrow-left' -%}
        </button>
      {%- endif -%}

      <div class="fh-announce__slides" aria-live="polite">
        {%- for block in announcements -%}
          <p
            class="fh-announce__slide fh-body-sm"
            data-slide
            {% if forloop.first %}data-active{% else %}aria-hidden="true"{% endif %}
            {{ block.shopify_attributes }}
          >
            <span>{{ block.settings.text }}</span>
            {%- if block.settings.link_label != blank -%}
              {%- assign label = block.settings.link_label -%}
              <a
                class="fh-link-underline"
                href="{{ block.settings.link | default: '#' }}"
                {% unless forloop.first %}tabindex="-1"{% endunless %}
              >{{- label -}}</a>
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>

      {%- if announcements.size > 1 -%}
        <button type="button" class="fh-announce__nav fh-announce__nav--next" data-next aria-label="{{ 'fh.next' | t }}">
          {%- render 'fh-icon', name: 'arrow-left' -%}
        </button>
      {%- endif -%}
    </fh-announcements>
  </div>
{%- endif -%}

{% stylesheet %}
  .fh-announce {
    background: var(--fh-announce-bg, var(--fh-sage));
    color: var(--fh-announce-fg, #000);
  }
  .fh-announce__inner {
    display: grid;
    grid-template-columns: 32px 1fr 32px;
    align-items: center;
    max-width: var(--fh-max);
    min-height: 32px;
    margin: 0 auto;
    padding: 6px clamp(16px, 8.5vw, 128px);
  }
  .fh-announce__slides { display: grid; grid-column: 2; text-align: center; overflow: hidden; }
  .fh-announce__slide {
    grid-area: 1 / 1;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0 6px;
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity 0.4s var(--fh-ease), transform 0.4s var(--fh-ease), visibility 0s 0.4s;
  }
  .fh-announce__slide[data-active] { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .fh-announce__nav { display: inline-flex; justify-content: center; opacity: 0.7; }
  .fh-announce__nav:hover { opacity: 1; }
  .fh-announce__nav .fh-icon { width: 16px; height: 16px; }
  .fh-announce__nav--next .fh-icon { transform: scaleX(-1); }
  .fh-announce__nav--prev { grid-column: 1; }
  .fh-announce__nav--next { grid-column: 3; }
  @media screen and (max-width: 749px) {
    .fh-announce__slide { font-size: 12px; line-height: 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FH Announcement bar",
  "tag": "aside",
  "class": "fh-section fh-section--announce",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#9baf8f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Limited Time: Sign Up & Get 20% Off" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FH Announcement bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Limited Time: Sign Up & Get 20% Off" } },
        { "type": "announcement", "settings": { "text": "Free Kismet Tee with Orders $250+", "link_label": "Shop Now" } },
        { "type": "announcement", "settings": { "text": "Refer a Friend & Earn $25", "link_label": "Share Now" } }
      ]
    }
  ]
}
{% endschema %}
