{%- comment -%}
  Figma 1:7 (hero "Made to move"), 1:1243 ("New Arrivals"), 1:1343 ("Elevated Essentials").
  Full-bleed image, black overlay, centered serif headline and pill buttons.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_tag = 'h2'
  if s.heading_level == 'h1'
    assign heading_tag = 'h1'
  endif
  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif
-%}

<section
  class="fh fh-hero"
  style="--fh-hero-h: {{ s.height }}px; --fh-hero-h-mobile: {{ s.height_mobile }}px; --fh-hero-overlay: {{ s.overlay | divided_by: 100.0 }};"
>
  {%- if s.link != blank -%}
    <a href="{{ s.link }}" class="fh-hero__cover" aria-label="{{ s.heading | strip_html | escape }}"></a>
  {%- endif -%}

  <div class="fh-hero__media fh-media">
    {%- if s.image_mobile != blank -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ s.image_mobile | image_url: width: 1000 }}">
        {% render 'fh-image', image: s.image, fallback: s.fallback_image, alt: s.heading, sizes: '100vw', width: 2400, loading: loading, w: 1512, h: 672 %}
      </picture>
    {%- else -%}
      {% render 'fh-image', image: s.image, fallback: s.fallback_image, alt: s.heading, sizes: '100vw', width: 2400, loading: loading, w: 1512, h: 672 %}
    {%- endif -%}
  </div>
  <div class="fh-hero__overlay" aria-hidden="true"></div>

  <div class="fh-hero__content">
    {%- if s.eyebrow != blank -%}
      <p class="fh-hero__eyebrow fh-eyebrow">
        {%- if s.show_stars -%}<span class="fh-hero__stars" aria-hidden="true">★★★★★</span> {% endif -%}
        {{- s.eyebrow -}}
      </p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <{{ heading_tag }} class="fh-hero__heading fh-display">{{ s.heading }}</{{ heading_tag }}>
    {%- endif -%}
    {%- if s.text != blank -%}
      <p class="fh-hero__text fh-lead">{{ s.text }}</p>
    {%- endif -%}
    {%- if s.button_label != blank or s.button_label_2 != blank -%}
      <div class="fh-hero__buttons">
        {%- if s.button_label != blank -%}
          <a href="{{ s.button_link | default: s.link | default: '#' }}" class="fh-btn">{{ s.button_label }}</a>
        {%- endif -%}
        {%- if s.button_label_2 != blank -%}
          <a href="{{ s.button_link_2 | default: '#' }}" class="fh-btn">{{ s.button_label_2 }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .fh-hero { position: relative; display: flex; align-items: center; justify-content: center; min-height: var(--fh-hero-h, 672px); overflow: hidden; color: #fff; isolation: isolate; }
  .fh-hero__media { position: absolute; inset: 0; z-index: -2; }
  .fh-hero__media picture { position: absolute; inset: 0; }
  .fh-hero__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fh-hero__overlay { position: absolute; inset: 0; z-index: -1; background: #000; opacity: var(--fh-hero-overlay, .15); pointer-events: none; }
  .fh-hero__cover { position: absolute; inset: 0; z-index: 1; }
  .fh-hero__content { position: relative; z-index: 2; pointer-events: none; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 64px; max-width: 100%; }
  .fh-hero__content a { pointer-events: auto; }
  .fh-hero__heading { padding-top: 8px; max-width: 1384px; }
  .fh-eyebrow + .fh-hero__heading { padding-top: 8px; }
  .fh-hero__heading:first-child { padding-top: 0; }
  .fh-hero__text { padding-top: 8px; }
  .fh-hero__buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; padding-top: 24px; }
  .fh-hero__stars { letter-spacing: 2px; }
  @media screen and (max-width: 749px) {
    .fh-hero { min-height: var(--fh-hero-h-mobile, 560px); }
    .fh-hero__content { padding: 48px 24px; }
    .fh-hero__buttons { flex-direction: column; align-items: stretch; width: 100%; max-width: 320px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FH Image banner",
  "class": "fh-hero-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "text", "id": "fallback_image", "label": "Placeholder image (theme asset)", "info": "Shown until an image is selected", "default": "fh-hero.jpg" },
    { "type": "range", "id": "overlay", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 15 },
    { "type": "range", "id": "height", "label": "Desktop height", "min": 500, "max": 700, "step": 2, "unit": "px", "default": 672 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 360, "max": 800, "step": 10, "unit": "px", "default": 560 },
    { "type": "url", "id": "link", "label": "Banner link", "info": "Makes the whole banner clickable" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "checkbox", "id": "show_stars", "label": "Show stars before eyebrow", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to move" },
    { "type": "select", "id": "heading_level", "label": "Heading tag", "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" } ], "default": "h2" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button label" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" }
  ],
  "presets": [
    {
      "name": "FH Image banner",
      "settings": {
        "heading": "New Arrivals",
        "text": "Check out our newest drops.",
        "button_label": "Shop men’s New arrivals",
        "overlay": 40,
        "fallback_image": "fh-new-arrivals.jpg"
      }
    }
  ]
}
{% endschema %}
