{%- comment -%}
  Instagram / social grid (Design refresh 2026, Figma node 1-1736)
  Navy heading bar with a handle, then a row of square posts edge to edge.
{%- endcomment -%}

{{ 'fh-instagram.css' | asset_url | stylesheet_tag }}

{% style %}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  #FhInstagram-{{ section.id }} {
    --fh-ig-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --fh-ig-bar: {{ section.settings.bar_color }};
    --fh-ig-heading-color: {{ section.settings.heading_color }};
    --fh-ig-handle-color: {{ section.settings.handle_color }};
    --fh-ig-columns: {{ section.settings.columns }};
  }
{% endstyle %}

{%- liquid
  assign handle = section.settings.handle | strip
  assign heading_id = 'FhInstagramHeading-' | append: section.id
-%}

<div
  id="FhInstagram-{{ section.id }}"
  class="fh-instagram"
>
  <div class="fh-instagram__bar">
    <h2
      id="{{ heading_id }}"
      class="fh-instagram__heading"
    >
      {{- section.settings.heading | escape -}}
      {%- if handle != blank %}
        {% if section.settings.handle_link != blank -%}
          <a
            href="{{ section.settings.handle_link }}"
            class="fh-instagram__handle"
            target="_blank"
            rel="noopener"
          >
            {{- handle | escape -}}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        {%- else -%}
          <span class="fh-instagram__handle">{{ handle | escape }}</span>
        {%- endif -%}
      {%- endif -%}
    </h2>
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul
      class="fh-instagram__grid"
      aria-labelledby="{{ heading_id }}"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          if block.settings.is_video
            assign post_label = 'Play video: ' | append: handle
          else
            assign post_label = 'View post: ' | append: handle
          endif
          if block.settings.label != blank
            assign post_label = block.settings.label
          endif
        -%}
        <li
          class="fh-instagram__item"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a
              href="{{ block.settings.link }}"
              class="fh-instagram__post"
              target="_blank"
              rel="noopener"
              aria-label="{{ post_label | escape }} (opens in a new tab)"
            >
          {%- else -%}
            <div class="fh-instagram__post">
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 760
              | image_tag:
                loading: 'lazy',
                widths: '190, 380, 570, 760',
                sizes: '(min-width: 750px) 25vw, 50vw',
                class: 'fh-instagram__image',
                alt: ''
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'fh-instagram__image' }}
          {%- endif -%}
          {%- if block.settings.is_video -%}
            <span
              class="fh-instagram__play"
              aria-hidden="true"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                focusable="false"
              >
                <path d="M3.75 4.875H9c1.036 0 1.875.84 1.875 1.875v4.5c0 1.036-.84 1.875-1.875 1.875H3.75a1.875 1.875 0 0 1-1.875-1.875v-4.5c0-1.036.84-1.875 1.875-1.875Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="m10.875 7.5 4.5-2.25v7.5l-4.5-2.25v-3Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Social grid (refresh)",
  "tag": "section",
  "class": "section-fh-instagram",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find us in the Wild"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@FairHarborClothing"
    },
    {
      "type": "url",
      "id": "handle_link",
      "label": "Handle link",
      "info": "e.g. your Instagram profile"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n4"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Posts per row on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "Heading bar",
      "default": "#223D72"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "Handle text",
      "default": "#C8D5E4"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post link"
        },
        {
          "type": "checkbox",
          "id": "is_video",
          "label": "Show video icon",
          "default": false
        },
        {
          "type": "text",
          "id": "label",
          "label": "Accessible label",
          "info": "Read by screen readers. Defaults to the handle."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social grid (refresh)",
      "blocks": [
        { "type": "post" },
        { "type": "post", "settings": { "is_video": true } },
        { "type": "post", "settings": { "is_video": true } },
        { "type": "post", "settings": { "is_video": true } }
      ]
    }
  ]
}
{% endschema %}
