{%- comment -%} Figma 1:2166 — "Promotional offers" bar {%- endcomment -%}
<div
  class="fh fh-announce"
  style="--fh-announce-bg: {{ section.settings.background }}; --fh-announce-fg: {{ section.settings.text_color }};"
>
  <fh-rotator class="fh-announce__inner" data-interval="{{ section.settings.speed }}">
    {%- for block in section.blocks -%}
      <p
        class="fh-announce__slide fh-small"
        data-fh-slide
        {% if forloop.first %}data-active{% else %}aria-hidden="true"{% endif %}
        {{ block.shopify_attributes }}
      >
        <span>{{ block.settings.text }}</span>
        {%- if block.settings.link_label != blank -%}
          <a href="{{ block.settings.link | default: '#' }}" class="fh-announce__link">{{ block.settings.link_label }}</a>
        {%- endif -%}
      </p>
    {%- endfor -%}
  </fh-rotator>
</div>

{% stylesheet %}
  .fh-announce { background: var(--fh-announce-bg, #9baf8f); color: var(--fh-announce-fg, #000); }
  .fh-announce__inner { display: grid; padding: 6px 128px; min-height: 32px; align-items: center; text-align: center; }
  .fh-announce__slide {
    grid-area: 1 / 1; display: flex; justify-content: center; gap: 6px; flex-wrap: wrap;
    opacity: 0; visibility: hidden; transform: translateY(4px);
    transition: opacity .4s ease, transform .4s ease, visibility .4s;
  }
  .fh-announce__slide[data-active] { opacity: 1; visibility: visible; transform: none; }
  .fh-announce__link { text-decoration: underline; text-underline-offset: 2px; }
  @media screen and (max-width: 749px) {
    .fh-announce__inner { padding: 6px 16px; }
    .fh-announce__slide { font-size: 12px; line-height: 18px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FH Announcement bar",
  "class": "fh-announce-section",
  "settings": [
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "default": 5 },
    { "type": "color", "id": "background", "label": "Background", "default": "#9baf8f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Limited Time: Sign Up & Get 20% Off" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FH Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Limited Time: Sign Up & Get 20% Off" } },
        { "type": "message", "settings": { "text": "Free Kismet Tee with Orders $250+", "link_label": "Shop Now" } },
        { "type": "message", "settings": { "text": "Refer a Friend & Earn $25", "link_label": "Share Now" } }
      ]
    }
  ]
}
{% endschema %}
