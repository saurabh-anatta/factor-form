<div
  class="custom-faqs"
  style="
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --faqs-bg: {{ section.settings.background_color }};
  "
>
  <div class="custom-faqs__container">
    {% if section.settings.heading != blank %}
      <h2 class="custom-faqs__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="custom-faqs__questions">
      {% for block in section.blocks %}
        <details
          class="custom-faqs__item"
          {{ block.shopify_attributes }}
          {% if forloop.first %}open{% endif %}
        >
          <summary class="custom-faqs__summary">
            <span class="custom-faqs__question">{{ block.settings.question | escape }}</span>
            <span class="custom-faqs__icon custom-faqs__icon--open" aria-hidden="true">
              {{ 'chevron-up.svg' | inline_asset_content }}
            </span>
            <span class="custom-faqs__icon custom-faqs__icon--closed" aria-hidden="true">
              {{ 'chevron-down.svg' | inline_asset_content }}
            </span>
          </summary>
          {% if block.settings.answer != blank %}
            <p class="custom-faqs__answer">{{ block.settings.answer | escape }}</p>
          {% endif %}
        </details>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
.custom-faqs {
  padding-block-start: var(--section-padding-top, 80px);
  padding-block-end: var(--section-padding-bottom, 80px);
  padding-inline: 64px;
  background-color: var(--faqs-bg, #FFFFFF);
}

.custom-faqs__container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-2xl, 4rem);
  max-width: var(--normal-page-width, 120rem);
  margin-inline: auto;
}

.custom-faqs__heading {
  color: #141414;
  text-align: center;
  margin: 0;
}

.custom-faqs__questions {
  display: flex;
  flex-direction: column;
  gap: 24px;
  width: 100%;
  max-width: 928px;
}

.custom-faqs__item {
  border-bottom: 1px solid #D0D0BC;
}

.custom-faqs__item[open] {
  padding-block: 24px;
}

.custom-faqs__item:not([open]) {
  padding-block-end: 24px;
}

.custom-faqs__summary {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  cursor: pointer;
  list-style: none;
}

.custom-faqs__summary::-webkit-details-marker {
  display: none;
}

.custom-faqs__summary::marker {
  display: none;
  content: '';
}

.custom-faqs__question {
  font-family: var(--font-subheading--family);
  font-weight: 600;
  font-size: 18px;
  line-height: 28px;
  letter-spacing: 0;
  color: #141414;
}

.custom-faqs__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 24px;
  height: 24px;
}

.custom-faqs__icon svg {
  width: 24px;
  height: 24px;
}

.custom-faqs__icon--open {
  display: none;
}

.custom-faqs__icon--closed {
  display: flex;
}

.custom-faqs__item[open] .custom-faqs__icon--open {
  display: flex;
}

.custom-faqs__item[open] .custom-faqs__icon--closed {
  display: none;
}

.custom-faqs__answer {
  color: #141414;
  margin: 12px 0 0;
}

@media screen and (max-width: 749px) {
  .custom-faqs {
    padding-block-start: 48px;
    padding-block-end: 48px;
    padding-inline: 16px;
  }

  .custom-faqs__container {
    gap: 24px;
    align-items: flex-start;
  }

  .custom-faqs__heading {
    text-align: start;
  }

  .custom-faqs__questions {
    gap: 20px;
  }

  .custom-faqs__item {
    border-bottom-color: #F1F1EA;
  }

  .custom-faqs__item[open] {
    padding-block: 20px;
  }

  .custom-faqs__item:not([open]) {
    padding-block-end: 20px;
  }

  .custom-faqs__summary {
    gap: 8px;
  }

  .custom-faqs__question {
    font-size: 16px;
    line-height: 24px;
  }

  .custom-faqs__answer {
    font-size: 14px;
    line-height: 20px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_faqs",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "faq-item",
      "name": "t:names.faq_item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:settings.question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "t:settings.answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_faqs",
      "blocks": [
        {
          "type": "faq-item",
          "settings": {
            "question": "What makes Factor Form products different?",
            "answer": "Factor Form products are built with clean, science-backed ingredients chosen for real, functional benefits; not trends or fillers. Each formula is optimised for daily performance, energy, and recovery. You get products that are effective, transparent, and designed to fit effortlessly into your routine."
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "Are Factor Form products third-party tested?"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "Are Factor Form products safe to use together?"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "Do you ship internationally?"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "What is your return policy?"
          }
        }
      ]
    }
  ]
}
{% endschema %}
