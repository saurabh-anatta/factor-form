{%- comment -%}
  Fair Harbor "Shop by activity" (Figma 1:1266).
  Sand background, serif heading with arrows, then 388x517 image cards with
  a bold centred label underneath.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign cards = section.blocks | where: 'type', 'card'
-%}

<fh-carousel class="fh fh-ccar" style="--fh-ccar-bg: {{ s.background }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;">
  <div class="fh-ccar__inner">
    <div class="fh-ccar__head">
      <h2 class="fh-h2">{{ s.heading }}</h2>
      <div class="fh-arrows">
        <button type="button" class="fh-arrow" data-prev aria-label="{{ 'fh.previous' | t }}" disabled>{%- render 'fh-icon', name: 'arrow-left' -%}</button>
        <button type="button" class="fh-arrow fh-arrow--next" data-next aria-label="{{ 'fh.next' | t }}">{%- render 'fh-icon', name: 'arrow-left' -%}</button>
      </div>
    </div>

    <ul class="fh-track fh-ccar__track" data-track role="list">
      {%- for block in cards -%}
        {%- liquid
          assign c = block.settings.collection
          assign title = block.settings.title | default: c.title
          assign url = block.settings.link | default: c.url | default: '#'
          assign img = block.settings.image | default: c.featured_image
        -%}
        <li class="fh-ccar__slide" {{ block.shopify_attributes }}>
          <a href="{{ url }}" class="fh-ccar__card">
            <span class="fh-ccar__media">
              {%- if img != blank -%}
                {{ img | image_url: width: 800 | image_tag: widths: '388, 600, 800', sizes: '(min-width: 990px) 388px, 72vw', loading: 'lazy', alt: '', class: 'fh-ccar__img' }}
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'fh-ccar__img fh-ccar__img--placeholder' }}
              {%- endif -%}
            </span>
            <span class="fh-ccar__label fh-body">{{ title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</fh-carousel>

{% stylesheet %}
  .fh-ccar { display: block; background: var(--fh-ccar-bg, var(--fh-sand)); overflow: hidden; }
  .fh-ccar__inner { max-width: var(--fh-max); margin: 0 auto; padding-left: var(--fh-gutter-sm); }
  .fh-ccar__head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-right: var(--fh-gutter-sm); }
  .fh-ccar__track { margin-top: 32px; padding-right: var(--fh-gutter-sm); }
  .fh-ccar__slide { width: 388px; }
  .fh-ccar__card { display: flex; flex-direction: column; }
  .fh-ccar__media { position: relative; display: block; aspect-ratio: 388 / 517; overflow: hidden; background: #e8e2dc; }
  .fh-ccar__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--fh-ease); }
  .fh-ccar__card:hover .fh-ccar__img { transform: scale(1.04); }
  .fh-ccar__label { display: block; padding: 20px 8px 16px; font-weight: 700; text-align: center; }
  .fh-ccar__card:hover .fh-ccar__label { text-decoration: underline; text-underline-offset: 4px; }
  @media screen and (max-width: 749px) {
    .fh-ccar__head .fh-arrows { display: none; }
    .fh-ccar__track { margin-top: 24px; gap: 12px; }
    .fh-ccar__slide { width: 72vw; max-width: 320px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FH Collection carousel",
  "tag": "section",
  "class": "fh-section fh-section--ccar",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by activity" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f4f0ed" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
        { "type": "text", "id": "title", "label": "Label", "info": "Defaults to the collection title." },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FH Collection carousel",
      "blocks": [
        { "type": "card", "settings": { "title": "Beach towels" } },
        { "type": "card", "settings": { "title": "All Swim" } },
        { "type": "card", "settings": { "title": "All New Arrivals" } },
        { "type": "card", "settings": { "title": "Men's Sweatshirts & Hoodies" } }
      ]
    }
  ]
}
{% endschema %}
