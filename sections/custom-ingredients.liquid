        {
          "type": "ingredient-item",
          "settings": {
            "heading": "Gut health blend",
            "description": "Prebiotic fiber plus two strains of live probiotics promote a healthy gut and support digestive health.*"
          }
        },
        {
          "type": "ingredient-item",
          "settings": {
            "heading": "Adaptogen blend",
            "description": "Rhodiola, Lion's Mane, and Ashwagandha support cognitive function, better sleep, healthy aging, and reduce everyday stress.*"
          }
        },
        {
          "type": "ingredient-item",
          "settings": {
            "heading": "Energy blend",
            "description": "B vitamins, ginseng, and adaptogens naturally support energy without caffeine.*"
          }
        },
        {
          "type": "ingredient-item",
          "settings": {
            "heading": "Immune support blend",
            "description": "Vitamins C & D, zinc, ginseng, and reishi mushroom support the immune system and healthy aging.*"
          }
        }
      ]
    }
  ]
}
{% endschema %}
