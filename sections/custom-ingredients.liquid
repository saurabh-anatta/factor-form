{% liquid
  assign heading = section.settings.heading
%}

<custom-ingredients-carousel>
  <div
    class="custom-ingredients"
    style="
      --section-padding-top: {{ section.settings.padding-block-start }}px;
      --section-padding-bottom: {{ section.settings.padding-block-end }}px;
      --ingredients-bg: {{ section.settings.background_color }};
    "
  >
    <div class="custom-ingredients__header">
      {% if heading != blank %}
        <h2 class="custom-ingredients__heading">{{ heading | escape }}</h2>
      {% endif %}
      <div class="custom-ingredients__arrows">
        <button type="button" class="custom-ingredients__arrow custom-ingredients__arrow--prev" aria-label="{{ 'sections.custom_ingredients.previous' | t }}">
          <img src="{{ 'chevron-up-4.svg' | asset_url }}" alt="" role="presentation" width="40" height="40" loading="lazy">
        </button>
        <button type="button" class="custom-ingredients__arrow custom-ingredients__arrow--next" aria-label="{{ 'sections.custom_ingredients.next' | t }}">
          <img src="{{ 'chevron-up-5.svg' | asset_url }}" alt="" role="presentation" width="40" height="40" loading="lazy">
        </button>
      </div>
    </div>

    <div class="custom-ingredients__track">
      {%- for block in section.blocks -%}
        <div class="custom-ingredients__card" {{ block.shopify_attributes }}>
          <div class="custom-ingredients__card-image">
            {%- if block.settings.image != blank -%}
              <img
                class="custom-ingredients__card-img"
                src="{{ block.settings.image | image_url: width: 448 }}"
                alt="{{ block.settings.heading | escape }}"
                width="224"
                height="224"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          <div class="custom-ingredients__card-content">
            {%- if block.settings.heading != blank -%}
              <h3 class="custom-ingredients__card-heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="custom-ingredients__card-description">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</custom-ingredients-carousel>

<script src="{{ 'custom-ingredients.js' | asset_url }}" type="module"></script>

{% stylesheet %}
.custom-ingredients {
  padding-block-start: var(--section-padding-top, 80px);
  padding-block-end: var(--section-padding-bottom, 80px);
  background-color: var(--ingredients-bg, #FFFFFF);
}

.custom-ingredients__header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-inline: 64px;
  margin-block-end: 48px;
  max-width: var(--normal-page-width, 120rem);
  margin-inline: auto;
}

.custom-ingredients__heading {
  font-family: var(--font-heading--family);
  font-weight: var(--font-heading--weight, 300);
  font-size: 48px;
  line-height: 56px;
  letter-spacing: 0;
  color: #141414;
  margin: 0;
}

.custom-ingredients__arrows {
  display: flex;
  flex-direction: row;
  gap: 0;
  align-items: center;
}

.custom-ingredients__arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  width: 40px;
  height: 40px;
}

.custom-ingredients__arrow--prev img {
  transform: rotate(-90deg);
}

.custom-ingredients__arrow--next img {
  transform: rotate(90deg);
}

.custom-ingredients__arrow:focus-visible {
  outline: 2px solid #141414;
  outline-offset: 2px;
  border-radius: 4px;
}

.custom-ingredients__track {
  display: flex;
  flex-direction: row;
  gap: 32px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-inline: 64px;
}

.custom-ingredients__track::-webkit-scrollbar {
  display: none;
}

.custom-ingredients__card {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 256px;
  flex: 0 0 256px;
  scroll-snap-align: start;
}

.custom-ingredients__card-image {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 256px;
  height: 256px;
  padding: 16px;
  background-color: #F1F1EA;
}

.custom-ingredients__card-img {
  display: block;
  width: 224px;
  height: 224px;
  object-fit: contain;
}

.custom-ingredients__card-content {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.custom-ingredients__card-heading {
  font-family: var(--font-subheading--family);
  font-weight: 600;
  font-size: 20px;
  line-height: 28px;
  letter-spacing: 0;
  color: #141414;
  margin: 0;
}

.custom-ingredients__card-description {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0;
  color: #141414;
  margin: 0;
}

@media screen and (max-width: 749px) {
  .custom-ingredients__header {
    padding-inline: 16px;
    margin-block-end: 24px;
  }

  .custom-ingredients__heading {
    font-size: 32px;
    line-height: 40px;
  }

  .custom-ingredients__arrows {
    display: none;
  }

  .custom-ingredients__track {
    padding-inline: 16px;
    gap: 16px;
  }

  .custom-ingredients__card {
    min-width: 200px;
    flex: 0 0 200px;
  }

  .custom-ingredients__card-image {
    width: 200px;
    height: 200px;
    padding: 12px;
  }

  .custom-ingredients__card-img {
    width: 176px;
    height: 176px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_ingredients",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Quality Ingredients"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "ingredient-item",
      "name": "t:names.ingredient_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:settings.description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_ingredients",
      "blocks": [
        {
          "type": "ingredient-item",
          "settings": {
            "heading": "Greens and fruits blend",
