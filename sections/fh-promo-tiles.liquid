{%- comment -%} Figma 1:1567 — two editorial promo tiles {%- endcomment -%}
<section class="fh fh-tiles" style="--fh-tiles-bg: {{ section.settings.background }};">
  <div class="fh-tiles__grid">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <article class="fh-tile" {{ block.shopify_attributes }}>
        <a href="{{ b.link | default: '#' }}" class="fh-tile__media fh-media" aria-label="{{ b.link_label | default: b.heading | escape }}">
          {% render 'fh-image', image: b.image, fallback: b.fallback_image, alt: b.heading, sizes: '(min-width: 990px) 676px, 100vw', width: 1400, w: 676, h: 676 %}
          {%- if b.overlay > 0 -%}
            <span class="fh-tile__overlay" style="opacity: {{ b.overlay | divided_by: 100.0 }};" aria-hidden="true"></span>
          {%- endif -%}
        </a>
        <div class="fh-tile__content">
          <h2 class="fh-h3">{{ b.heading }}</h2>
          {%- if b.text != blank -%}<p class="fh-tile__text fh-body">{{ b.text }}</p>{%- endif -%}
          {%- if b.link_label != blank -%}
            <div class="fh-tile__cta"><a href="{{ b.link | default: '#' }}" class="fh-tile__link fh-body">{{ b.link_label }}</a></div>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .fh-tiles { background: var(--fh-tiles-bg, #fff); padding: 24px var(--fh-gutter); }
  .fh-tiles__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; max-width: 1384px; margin: 0 auto; }
  .fh-tile__media { display: block; aspect-ratio: 1 / 1; }
  .fh-tile__media img { transition: transform .6s ease; }
  .fh-tile__media:hover img { transform: scale(1.02); }
  .fh-tile__overlay { position: absolute; inset: 0; background: #000; pointer-events: none; }
  .fh-tile__content { background: #fff; padding: 8px 0; color: var(--fh-navy); }
  .fh-tile__text { padding-top: 3px; }
  .fh-tile__cta { padding-top: 12px; }
  .fh-tile__link { font-weight: 700; }
  .fh-tile__link:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .fh-tiles__grid { grid-template-columns: 1fr; gap: 24px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FH Promo tiles",
  "class": "fh-tiles-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_image", "label": "Placeholder image (theme asset)" },
        { "type": "range", "id": "overlay", "label": "Overlay opacity", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 0 },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Bundle & Save" },
        { "type": "text", "id": "text", "label": "Text", "default": "Buy more of what you love, for less." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop Bundles" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FH Promo tiles",
      "blocks": [
        { "type": "tile", "settings": { "fallback_image": "fh-bundle.jpg" } },
        { "type": "tile", "settings": { "heading": "Make it Personalized", "text": "Explore our eligible styles, customizable with up to three initials or our new icons.", "link_label": "Shop Personalized", "fallback_image": "fh-personalize.jpg", "overlay": 15 } }
      ]
    }
  ]
}
{% endschema %}
