{%- comment -%}
  Promo tiles (Design refresh 2026, Figma node 1-1567)
  Two (or more) square image tiles, each with a heading, text and link below.
{%- endcomment -%}

{{ 'fh-promo-tiles.css' | asset_url | stylesheet_tag }}

{% style %}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  #FhPromoTiles-{{ section.id }} {
    --fh-pt-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --fh-pt-columns: {{ section.settings.columns }};
    --fh-pt-padding-top: {{ section.settings.padding_top }}px;
    --fh-pt-padding-bottom: {{ section.settings.padding_bottom }}px;
    --fh-pt-background: {{ section.settings.background_color }};
  }
{% endstyle %}

<div
  id="FhPromoTiles-{{ section.id }}"
  class="fh-promo-tiles"
>
  <div class="fh-promo-tiles__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile_url = block.settings.link
        assign overlay = block.settings.overlay_opacity | divided_by: 100.0
      -%}
      <div
        class="fh-promo-tiles__tile"
        {{ block.shopify_attributes }}
      >
        {%- if tile_url != blank -%}
          <a
            href="{{ tile_url }}"
            class="fh-promo-tiles__media"
            tabindex="-1"
            aria-hidden="true"
          >
        {%- else -%}
          <div class="fh-promo-tiles__media">
        {%- endif -%}
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '375, 550, 750, 1000, 1352, 1400',
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'fh-promo-tiles__image',
              alt: ''
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'fh-promo-tiles__image' }}
        {%- endif -%}
        {%- if overlay > 0 -%}
          <span
            class="fh-promo-tiles__overlay"
            style="opacity: {{ overlay }};"
          ></span>
        {%- endif -%}
        {%- if tile_url != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}

        <div class="fh-promo-tiles__content">
          {%- if block.settings.heading != blank -%}
            <h2 class="fh-promo-tiles__heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="fh-promo-tiles__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank and tile_url != blank -%}
            <a
              href="{{ tile_url }}"
              class="fh-promo-tiles__link"
            >
              {{- block.settings.link_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Promo tiles (refresh)",
  "tag": "section",
  "class": "section-fh-promo-tiles",
  "max_blocks": 4,
  "settings": [
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n4"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image darkening",
          "min": 0,
          "max": 60,
          "step": 5,
          "unit": "%",
          "default": 0
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Tile heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Short supporting text."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo tiles (refresh)",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
