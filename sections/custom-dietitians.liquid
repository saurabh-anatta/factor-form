<div
  class="custom-dietitians"
  style="
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --dietitians-bg: {{ section.settings.background_color }};
  "
>
  <div class="custom-dietitians__container">
    <div class="custom-dietitians__header">
      {% if section.settings.heading != blank %}
        <h2 class="custom-dietitians__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="custom-dietitians__description">{{ section.settings.description | escape }}</p>
      {% endif %}
    </div>

    <div class="custom-dietitians__cards">
      {% for block in section.blocks %}
        <div class="custom-dietitians__card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="custom-dietitians__image-wrapper">
              <img
                class="custom-dietitians__image"
                src="{{ block.settings.image | image_url: width: 656 }}"
                alt="{{ block.settings.author | escape }}"
                width="328"
                height="328"
                loading="lazy"
              >
            </div>
          {% endif %}
          <div class="custom-dietitians__content">
            <div class="custom-dietitians__text-group">
              {% if block.settings.quote != blank %}
                <h3 class="custom-dietitians__quote">{{ block.settings.quote | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="custom-dietitians__body">{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>
            {% if block.settings.author != blank %}
              <div class="custom-dietitians__author">
                <span>{{ block.settings.author | escape }}</span>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
.custom-dietitians {
  padding-block-start: var(--section-padding-top, 80px);
  padding-block-end: var(--section-padding-bottom, 80px);
  padding-inline: 64px;
  background-color: var(--dietitians-bg, #F1F1EA);
}

.custom-dietitians__container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 48px;
  max-width: var(--normal-page-width, 120rem);
  margin-inline: auto;
}

.custom-dietitians__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.custom-dietitians__heading {
  font-family: var(--font-heading--family);
  font-weight: var(--font-heading--weight, 300);
  font-size: 48px;
  line-height: 56px;
  letter-spacing: 0;
  color: #141414;
  text-align: center;
  margin: 0;
}

.custom-dietitians__description {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 18px;
  line-height: 28px;
  letter-spacing: 0;
  color: #141414;
  text-align: center;
  margin: 0;
}

.custom-dietitians__cards {
  display: flex;
  flex-direction: row;
  gap: 32px;
  justify-content: center;
  max-width: 1048px;
  width: 100%;
}

.custom-dietitians__card {
  display: flex;
  flex-direction: column;
  gap: 0;
  flex: 1;
  max-width: 328px;
}

.custom-dietitians__image-wrapper {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background-color: #F1F1EA;
}

.custom-dietitians__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.custom-dietitians__content {
  display: flex;
  flex-direction: column;
  gap: 24px;
  justify-content: space-between;
  padding: 20px 16px;
  background-color: #FFFFFF;
  flex: 1;
}

.custom-dietitians__text-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.custom-dietitians__quote {
  font-family: var(--font-subheading--family);
  font-weight: 600;
  font-size: 20px;
  line-height: 28px;
  letter-spacing: 0;
  color: #141414;
  margin: 0;
}

.custom-dietitians__body {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0;
  color: #141414;
  margin: 0;
}

.custom-dietitians__author {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  letter-spacing: 0;
  color: #141414;
}

@media screen and (max-width: 749px) {
  .custom-dietitians {
    padding-block-start: 48px;
    padding-block-end: 48px;
    padding-inline: 16px;
  }

  .custom-dietitians__container {
    gap: 32px;
    align-items: flex-start;
  }

  .custom-dietitians__header {
    align-items: flex-start;
  }

  .custom-dietitians__heading {
    font-size: 32px;
    line-height: 40px;
    text-align: start;
  }

  .custom-dietitians__description {
    text-align: start;
  }

  .custom-dietitians__cards {
    flex-direction: column;
    gap: 24px;
    max-width: none;
  }

  .custom-dietitians__card {
    max-width: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_dietitians",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Backed By Factor Dietitians"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:settings.description"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#F1F1EA"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "dietitian-item",
      "name": "t:names.dietitian_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "t:settings.quote"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:settings.description"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:settings.author"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_dietitians",
      "blocks": [
        {
          "type": "dietitian-item",
          "settings": {
            "quote": "\"A rigorous 'no list' of over 100 banned ingredients\"",
            "description": "Factor Form upholds strong nutrition and ingredient standards across all products. We ensure only high quality ingredients make it into our products",
            "author": "Kara Kash   |   Research & Development"
          }
        },
        {
          "type": "dietitian-item",
          "settings": {
            "quote": "\"One serving equals a whole serving of green leafy veggies\"",
            "description": "I love that the vitamin and mineral content is balanced; the daily value percentages aren't excessive",
            "author": "Carlie Williams   |   Dietitian + Personal Trainer"
          }
        },
        {
          "type": "dietitian-item",
          "settings": {
            "quote": "\"A good mix of B vitamins along with typical electrolytes\"",
            "description": "B Vitamins act as coenzymes when your body is metabolizing energy, so it's nice to have that in an electrolyte mix",
            "author": "Olivia Hamilton   |   Dietitian"
          }
        }
      ]
    }
  ]
}
{% endschema %}
